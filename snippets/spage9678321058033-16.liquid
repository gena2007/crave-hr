                  <img class="sp-add-cart-icon" src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/icon.svg?v=1786518955" alt="" width="30" height="30" loading="lazy" decoding="async">
                </button>
              </div>

              <button class="sp-btn-style btn-style js-buy-now mb-banner-cta" type="button">
                <span>{{ sp_shop_now_label }}</span>
                <span class="sp-buy-arrow" aria-hidden="true">
                  <img
                    class="mb-cta-icon-img"
                    src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/icon_2x_bea56d6f-7f75-4730-bbf7-e8b6c09c1a2e.png?v=1786946817"
                    alt=""
                    width="27"
                    height="27"
                    loading="eager"
                    decoding="async"
                  >
                </span>
              </button>

              <div class="sp-footer-wrap">
                <div class="sp-delivery-note">
                  <span class="sp-delivery-icon" aria-hidden="true">
                    <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/icon_delivery.svg?v=1786518956" alt="" width="24" height="24" loading="lazy" decoding="async">
                  </span>
                  <span>{{ sp_delivery_label }}
                    <strong><span data-sp-delivery-start></span><span class="sp-delivery-separator"> – </span><span data-sp-delivery-end></span></strong>
                  </span>
                </div>

                <div class="sp-vat-note">
                  <span class="sp-vat-icon" aria-hidden="true">
                    <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/icon_vat.svg?v=1786518956" alt="" width="22" height="22" loading="lazy" decoding="async">
                  </span>
                  <span>{{ sp_vat_label }}</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="sp-trust-shell" aria-label="{{ sp_trust_aria }}">
