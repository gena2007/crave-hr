                  <img class="sp-thumb-nav-icon sp-thumb-nav-icon--mb" src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/2_2.svg?v=1787045958" alt="" width="4" height="7" aria-hidden="true">
                </button>
                <button class="sp-thumb-next js-thumb-next" type="button" aria-label="Miniaturas siguientes">
                  <img class="sp-thumb-nav-icon sp-thumb-nav-icon--pc" src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/2_1.svg?v=1787045190" alt="" width="12" height="7" aria-hidden="true">
                  <img class="sp-thumb-nav-icon sp-thumb-nav-icon--mb" src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/2_3.svg?v=1787045958" alt="" width="4" height="7" aria-hidden="true">
                </button>
              </div>
            </div>
          </div>

          <div class="sp_product_inner js-product-inner">
