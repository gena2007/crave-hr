      window.spLocale = {{ request.locale.iso_code | json }};
      window.cartCount = {{ cart.item_count | json }};
      window.spSelectedVariantId = {{ product.selected_or_first_available_variant.id | json }};
      window.spProductTitle = {{ product.title | json }};
    </script>

    <script src="{{ 'jquery.min.js' | asset_url }}" defer></script>
