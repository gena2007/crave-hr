                      <div class="sp-countdown-progress" aria-hidden="true">
                        <span class="sp-countdown-progress__fill"></span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="sp-product-thumbs swiper" aria-label="Miniatury produktu" data-sp-product-thumbs>
