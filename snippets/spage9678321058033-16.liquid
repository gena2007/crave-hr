                  {%- for sp_ticker_copy in sp_ticker_copies -%}
                    <div class="swiper-slide">{{ sp_ticker_copy }}</div>
                  {%- endfor -%}
                </div>
              </div>

              <div class="sp-specialist-line">
                <img class="sp-specialist-avatar" src="{{ sp_specialist_image }}" alt="" width="33" height="32" loading="lazy" aria-hidden="true">
