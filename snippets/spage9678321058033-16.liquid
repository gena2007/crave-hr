<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'hr' }}" dir="ltr">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link
      rel="preload"
      as="image"
      href="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105580_banner_bg_pc.webp?v=1787825077"
      media="(min-width: 768px)"
      fetchpriority="high"
    >
    <link
      rel="preload"
      as="image"
      href="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105580_banner_bg_mb_2.webp?v=1787970324"
      media="(max-width: 767px)"
      fetchpriority="high"
    >
  </head>
  <body>
    {{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
    <link rel="stylesheet" href="https://cdn.shopify.com/s/files/1/0807/0086/6801/files/spage9678321058033-16.css?v=1789020856">
    <style>
      #sticky-cart-portal{display:block !important;}
    </style>

    <div
      id="root"
      data-page-id="ID-16-YH105580-hr-G43"
      style="
        --wrapper-mw: 1400px;
        --wrapper-padding-mb: 16px;
        --primary-color: #FFA41C;
        --primary-hover-color: #FFA41C;
        --accent-color: #FFA41C;
        --secondary-color: #f3f3f3;
        --third-color: #ffffff;
        --btn-color: #050505;
        --border-color: #050505;
      "
    >

      {% liquid
        assign page_discount_variant = product.selected_or_first_available_variant
        assign page_discount_price = page_discount_variant.price
        assign page_discount_compare = page_discount_variant.compare_at_price
        assign page_discount_percent = 0
        if page_discount_compare > page_discount_price and page_discount_compare > 0
          assign page_discount_percent = page_discount_compare | minus: page_discount_price | times: 100.0 | divided_by: page_discount_compare | ceil
        endif
      %}

      <section class="sph" id="sph-header" data-sp-header aria-label="Encabezado de la página">
        {% liquid
          assign sph_nav_text = 'Vodič za veličine|||Recenzije|||Česta pitanja' | split: '|||'
          assign sph_nav_target = 'size|||reviews|||faq' | split: '|||'
          assign sph_nav_icon = 'https://cdn.shopify.com/s/files/1/0688/0460/8043/files/size-chart.svg?v=1786778904|||https://cdn.shopify.com/s/files/1/0688/0460/8043/files/reviews.svg?v=1786778904|||https://cdn.shopify.com/s/files/1/0688/0460/8043/files/faq.svg?v=1786778904' | split: '|||'
        %}

        <div class="sph__inner">
          <a class="sph__logo" href="#shopping" aria-label="{{ shop.name | escape }}">
            <img src="{{ settings.logo | image_url: width: 600 }}" alt="{{ shop.name | escape }}" width="136" height="45" loading="eager" decoding="async">
          </a>

          <div class="sph__perks" aria-label="Pogodnosti kupnje">
            <span class="sph__perk"><span>Plaćanje pouzećem</span></span>
            <span class="sph__perk sph__perk--delivery">
              <span>Brza dostava</span>
              <img
                src="https://cdn.shopify.com/s/files/1/0991/9614/1880/files/hot.png?v=1776492941"
                alt=""
                width="35"
                height="25"
                loading="eager"
                decoding="async"
              >
            </span>
          </div>

          <nav class="sph__nav" aria-label="Navigacija po odjeljcima">
            {%- for text in sph_nav_text -%}
              {%- assign nav_label = text | strip -%}
              {%- assign nav_target = sph_nav_target[forloop.index0] | default: '' | replace: '#', '' | strip -%}
              {%- assign nav_icon_url = sph_nav_icon[forloop.index0] | default: '' | strip -%}
              <a class="sph__nav-link sph__nav-link--{{ forloop.index }}" href="#{{ nav_target | escape }}">
                <span>{{ nav_label | escape }}</span>
                <img src="{{ nav_icon_url }}" alt="" width="20" height="20" loading="lazy" decoding="async">
              </a>
              {%- unless forloop.last -%}
                <span class="sph__nav-sep" aria-hidden="true"></span>
              {%- endunless -%}
            {%- endfor -%}
          </nav>

          <button class="sph__action sph__action--cart js-cart" type="button">
            <span>Pogledaj košaricu</span>
            <span class="sph__action-icon sph__action-icon--cart" aria-hidden="true">
              <img
                src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/cart_cb02b4fd-a771-4dbf-b31d-a4c05131be1b.svg?v=1786778904"
                alt=""
                width="27"
                height="27"
                loading="eager"
                decoding="async"
              >
              <span class="sph__cart-count js-cardNum{% if cart.item_count < 1 %} sp-gray{% endif %}">{{ cart.item_count }}</span>
            </span>
          </button>

          <a class="sph__action sph__action--shop" href="#shopping">
            <span>Kupi odmah</span>
            <span class="sph__action-icon sph__action-icon--arrow" aria-hidden="true">
              <img
                src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/2374239d8cd7f0857b5ab4b254ddf575.svg?v=1786779537"
                alt=""
                width="18"
                height="9"
                loading="eager"
                decoding="async"
              >
            </span>
          </a>
        </div>

        <div class="sph__mobile-inner">
          <a class="sph__mobile-logo" href="#shopping" aria-label="{{ shop.name | escape }}">
            <img src="{{ settings.logo | image_url: width: 600}}" alt="{{ shop.name | escape }}" width="145" height="38" loading="eager" decoding="async">
          </a>

          <div class="sph__mobile-actions">
            <a class="sph__mobile-buy" href="#shopping">
              <span class="sph__mobile-buy-icon" aria-hidden="true">
                <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/icon.svg?v=1786518955" alt="" width="19" height="18" loading="eager" decoding="async">
                <span class="sph__mobile-cart-count js-cardNum{% if cart.item_count < 1 %} sp-gray{% endif %}">{{ cart.item_count }}</span>
              </span>
              <span>Kupi odmah</span>
            </a>

            <button class="sph__mobile-menu js-sp-header-menu-btn" type="button" aria-label="Otvori navigacijski izbornik" aria-expanded="false" aria-controls="sph-drawer">
              <span aria-hidden="true"></span>
              <span aria-hidden="true"></span>
              <span aria-hidden="true"></span>
            </button>
          </div>
        </div>

        <div class="sph__drawer-backdrop js-sp-header-menu-btn" data-header-menu aria-hidden="true"></div>
        <aside class="sph__drawer" id="sph-drawer" data-header-menu aria-hidden="true">
          <div class="sph__drawer-head">
            <strong>Izbornik</strong>
            <button class="sph__drawer-close js-sp-header-menu-btn" type="button" aria-label="Zatvori navigacijski izbornik">×</button>
          </div>
          <nav class="sph__drawer-nav" aria-label="Mobilna navigacija">
            {%- for text in sph_nav_text -%}
              {%- assign nav_label = text | strip -%}
              {%- assign nav_target = sph_nav_target[forloop.index0] | default: '' | replace: '#', '' | strip -%}
              {%- assign nav_icon_url = sph_nav_icon[forloop.index0] | default: '' | strip -%}
              <a class="sph__drawer-link js-sp-header-menu-btn" href="#{{ nav_target | escape }}">
                <img src="{{ nav_icon_url }}" alt="" width="20" height="20" loading="lazy" decoding="async">
                <span>{{ nav_label | escape }}</span>
              </a>
            {%- endfor -%}
            <button class="sph__drawer-link js-cart js-sp-header-menu-btn" type="button">
              <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/icon.svg?v=1786518955" alt="" width="20" height="20" loading="lazy" decoding="async">
              <span>Coș (<span class="js-cardNum">{{ cart.item_count }}</span>)</span>
            </button>
          </nav>
        </aside>
      </section>

      <section class="sp-part banner-box v24-banner" aria-label="Ortopedske cipele za hodanje">
        {% liquid
          assign banner_rating_alt = 'Ocjena kupaca'
          assign banner_title_line_1 = 'Hodajte dulje,'
          assign banner_title_line_2 = 'Osjećajte se bolje pri svakom koraku'
          assign banner_title_mobile = 'Hodajte dulje, osjećajte se bolje pri svakom koraku'
          assign banner_subtitle = 'Ortopedske cipele za hodanje, stvorene za svakodnevnu udobnost'
          assign banner_description = 'Ortopedske cipele s potporom koja ublažava bol za sigurnije svakodnevno hodanje.'
          assign banner_cta_before_discount = 'Uštedite do'
          assign banner_cta_after_discount = 'odmah'
          assign banner_features_label = 'Prednosti proizvoda'
          assign banner_feature_labels = 'ORTOPEDSKE|||UBLAŽAVANJE BOLI|||ERGONOMSKE' | split: '|||'
          assign banner_background_pc = 'https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105580_banner_bg_pc.webp?v=1787825077'
          assign banner_background_mb = 'https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105580_banner_bg_mb_2.webp?v=1787970324'
          assign banner_rating_pc = 'https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105580_banner_rating_pc.svg?v=1787825075'
          assign banner_rating_mb = 'https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105580_banner_rating_mb.svg?v=1787825076'
          assign banner_button_icon = 'https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105580_btn_icon_adeb816e-6644-4294-816d-bdfd55fc752f.svg?v=1787825076'
          assign banner_quality = 'https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105580_banner_quality.webp?v=1787825076'
          assign banner_cross_icon = 'https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105580_banner_cross_icon_5019e9cd-aa91-4863-b901-5de765557fd0.webp?v=1787825076'
          assign banner_feature_icons = 'https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105580_banner_orthopedic.svg?v=1787825076|||https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105580_banner_pain-relief.svg?v=1787825076|||https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105580_banner_ergonomic.svg?v=1787825076' | split: '|||'
        %}

        <picture class="v24-banner__background" aria-hidden="true">
          <source media="(max-width: 767px)" srcset="{{ banner_background_mb }}">
          <img src="{{ banner_background_pc }}" alt="" width="1921" height="850" loading="eager" fetchpriority="high" decoding="async">
        </picture>

        <div class="v24-banner__inner">
          <div class="v24-banner__content">
            <img
              class="v24-banner__rating v24-banner__rating--pc"
              src="{{ banner_rating_pc }}"
              alt="{{ banner_rating_alt | escape }}"
              width="360"
              height="31"
              loading="eager"
              decoding="async"
            >
            <img
              class="v24-banner__rating v24-banner__rating--mb"
              src="{{ banner_rating_mb }}"
              alt="{{ banner_rating_alt | escape }}"
              width="243"
              height="26"
              loading="eager"
              decoding="async"
            >

            <div class="v24-banner__copy">
              <h1 class="v24-banner__title">
                <span class="v24-banner__title-pc">{{ banner_title_line_1 }} {{ banner_title_line_2 }}</span>
                <span class="v24-banner__title-mb">{{ banner_title_mobile }}</span>
              </h1>
              <p class="v24-banner__subtitle">{{ banner_subtitle }}</p>
              <p class="v24-banner__description">{{ banner_description }}</p>
            </div>

            <div class="v24-banner__badges" aria-label="Insignias de calidad y comodidad">
              <img class="v24-banner__badge v24-banner__badge--quality" src="{{ banner_quality }}" alt="Garanție de calitate" width="140" height="140" loading="eager" decoding="async">
              <img class="v24-banner__badge v24-banner__badge--cross" src="{{ banner_cross_icon }}" alt="Comodidad ortopédica" width="139" height="139" loading="eager" decoding="async">
            </div>

            <ul class="v24-banner__features" aria-label="{{ banner_features_label | escape }}">
              {% for feature_label in banner_feature_labels %}
                {% assign feature_index = forloop.index0 %}
                <li>
                  <img src="{{ banner_feature_icons[feature_index] }}" alt="" width="93" height="93" loading="eager" decoding="async">
                  <span>{{ feature_label }}</span>
                </li>
              {% endfor %}
            </ul>

            <a class="v24-banner__cta" href="#shopping">
              <span class="v24-banner__cta-copy">
                {{ banner_cta_before_discount }}
                <span class="js-bind-discount-percent" data-discount-sync>{{ page_discount_percent }}%</span>
                {{ banner_cta_after_discount }}
              </span>
              <span class="v24-banner__cta-icon" aria-hidden="true">
                <img src="{{ banner_button_icon }}" alt="" width="30" height="30" loading="eager" decoding="async">
              </span>
            </a>
          </div>
        </div>
      </section>

      <section class="sp-part2 sp2" id="size" aria-label="Vodič za veličine, jamstva kupnje i informacije o svakodnevnoj udobnosti stopala">
        {% liquid
          assign sp2_rating_pc = 'https://cdn.shopify.com/s/files/1/0688/0460/8043/files/sp2-rating-pc.webp?v=1787882349'
          assign sp2_rating_mb = 'https://cdn.shopify.com/s/files/1/0688/0460/8043/files/sp2-rating-mb.webp?v=1787882349'
          assign sp2_rating_alt = 'Ocijenjeno s 4.7 od 5'
          assign sp2_reviews_copy = '100% provjereno na temelju 2.179 recenzija proizvoda'
          assign sp2_guarantee_title = '90-DNEVNO JAMSTVO BEZ RIZIKA!'
          assign sp2_guarantee_title_mb = '90-dnevno jamstvo bez rizika'
          assign sp2_emoji_left = 'https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105580_emoji_1.webp?v=1787882349'
          assign sp2_emoji_right = 'https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105580_emoji_2.webp?v=1787882349'
          assign sp2_service_labels = 'Lokalna dostava|||Kupnja bez rizika|||Narudžba obrađena u roku od 24 sata|||Povrat novca u roku od 90 dana' | split: '|||'
          assign sp2_service_icons = 'https://cdn.shopify.com/s/files/1/0807/0086/6801/files/local_connwan.svg?v=1789008825|||https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105580_risk_1.svg?v=1788258795|||https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105580_24_1.svg?v=1788258795|||https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105580_90_1.svg?v=1788258795' | split: '|||'
          assign size_chart_title = 'Vodič za veličine'
          assign size_chart_eu_label = 'EU'
          assign size_chart_length_label = 'Duljina'
          assign size_chart_unit_label = 'mm'
          assign size_chart_rows = '36|230|45|275|||37|235|46|280|||38|240|47|285|||39|245|48|290|||40|250|49|295|||41|255|50|300|||42|260|51|305|||43|265|52|310|||44|270|53|315' | split: '|||'
          assign size_chart_measure_image_pc = 'https://cdn.shopify.com/s/files/1/0688/0460/8043/files/sp2-measurement-pc.webp?v=1787882348'
          assign size_chart_measure_image_mb = 'https://cdn.shopify.com/s/files/1/0688/0460/8043/files/sp2-measurement-mb.webp?v=1787882349'
          assign size_chart_measure_image_alt = 'Upute za mjerenje duljine i širine stopala'
          assign size_chart_tips = 'Pri mjerenju nosite čarape i stojte prirodno.|||Moguće je odstupanje mjerenja od 0,3 do 0,5 cm.|||Ako ste između dvije veličine, odaberite veću.' | split: '|||'
          assign size_chart_notice_icon = 'https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105580_90_1.svg?v=1788258795'
          assign size_chart_notice_title = 'Brinete se da vam veličina možda neće odgovarati?'
          assign size_chart_notice_description_before = 'Ne brinite — nudimo'
          assign size_chart_notice_emphasis = '90-dnevno'
          assign size_chart_notice_description_after = 'jamstvo odgovarajuće veličine. Ako vam ne odgovaraju, možete ih besplatno vratiti ili zamijeniti.'
          assign pain_title = 'Traže li vaša stopala pomoć?'
          assign pain_subtitle = 'Zaustavite svakodnevno opterećenje stopala prije nego što se pogorša'
          assign pain_labels = 'Utrnuli prsti zbog trenja|||Peckanje u petama nakon hodanja|||Teške noge i bolna koljena|||Nesigurni koraci na skliskom' | split: '|||'
          assign pain_images = 'https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105580_sp3_1.webp?v=1787884390|||https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105580_sp3_2.webp?v=1787884389|||https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105580_sp3_3.webp?v=1787884390|||https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105580_sp3_4.webp?v=1787884390' | split: '|||'
          assign pain_warning = 'https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105580_sp2_warning.svg?v=1787884599'
        %}
        <div class="sp2__main">
          <div class="sp2__guarantee">
            <div class="sp2__guarantee-top">
              <div class="sp2__rating">
                <picture>
                  <source media="(max-width: 767px)" srcset="{{ sp2_rating_mb }}">
                  <img src="{{ sp2_rating_pc }}" alt="{{ sp2_rating_alt | escape }}" width="260" height="23" loading="lazy" decoding="async">
                </picture>
                <span>{{ sp2_reviews_copy }}</span>
              </div>

              <div class="sp2__guarantee-heading">
                <img src="{{ sp2_emoji_left }}" alt="" width="49" height="47" loading="lazy" decoding="async">
                <h2>
                  <span class="sp2__heading-pc">{{ sp2_guarantee_title }}</span>
                  <span class="sp2__heading-mb">{{ sp2_guarantee_title_mb }}</span>
                </h2>
                <img src="{{ sp2_emoji_right }}" alt="" width="46" height="44" loading="lazy" decoding="async">
              </div>
            </div>

            <ul class="sp2__services" aria-label="Pogodnosti kupnje">
              {% for service_label in sp2_service_labels %}
                {% assign service_index = forloop.index0 %}
                <li class="sp2__service sp2__service--{{ forloop.index }}">
                  <img src="{{ sp2_service_icons[service_index] }}" alt="" width="62" height="62" loading="lazy" decoding="async">
                  {% if forloop.index == 3 %}
                    <span>Comandă procesată<br class="sp2__service-break"> în 24 de ore</span>
                  {% else %}
                    <span>{{ service_label }}</span>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </div>

          <div class="size-chart">
            <div class="size-chart__inner" data-size-chart-reusable>
              <h2 class="size-chart__title">{{ size_chart_title }}</h2>

              <div class="size-chart__content">
                <div class="size-chart__table-panel">
                  <div class="size-chart__table-wrap">
                    <table class="size-chart__table">
                      <thead>
                        <tr>
                          <th scope="col">{{ size_chart_eu_label }}</th>
                          <th scope="col"><span class="size-chart__pc-label"><span class="size-chart__pc-length-main">{{ size_chart_length_label }}</span><span class="size-chart__pc-length-unit">({{ size_chart_unit_label }})</span></span><span class="size-chart__mobile-label"><span class="size-chart__mobile-length-main">{{ size_chart_length_label }}</span><span class="size-chart__mobile-length-unit">({{ size_chart_unit_label }})</span></span></th>
                          <th scope="col">{{ size_chart_eu_label }}</th>
                          <th scope="col"><span class="size-chart__pc-label"><span class="size-chart__pc-length-main">{{ size_chart_length_label }}</span><span class="size-chart__pc-length-unit">({{ size_chart_unit_label }})</span></span><span class="size-chart__mobile-label"><span class="size-chart__mobile-length-main">{{ size_chart_length_label }}</span><span class="size-chart__mobile-length-unit">({{ size_chart_unit_label }})</span></span></th>
                        </tr>
                      </thead>
                      <tbody>
                        {% for size_chart_row in size_chart_rows %}
                          {% assign size_chart_cells = size_chart_row | split: '|' %}
                          <tr>
                            {% for size_chart_cell in size_chart_cells %}
                              <td>{{ size_chart_cell }}</td>
                            {% endfor %}
                          </tr>
                        {% endfor %}
                      </tbody>
                    </table>
                  </div>
                </div>

                <div class="size-chart__details">
                  <div class="size-chart__notice">
                    <img class="size-chart__notice-icon" src="{{ size_chart_notice_icon }}" alt="" width="83" height="83" loading="lazy" decoding="async">
                    <div class="size-chart__notice-text">
                      <strong class="size-chart__notice-title">{{ size_chart_notice_title }}</strong>
                      <p class="size-chart__notice-description">{{ size_chart_notice_description_before }} <span class="size-chart__notice-emphasis">{{ size_chart_notice_emphasis }}</span> {{ size_chart_notice_description_after }}</p>
                    </div>
                  </div>

                  <div class="size-chart__measure">
                    <picture class="size-chart__measure-picture">
                      <source media="(max-width: 767px)" srcset="{{ size_chart_measure_image_mb }}">
                      <img class="size-chart__measure-image" src="{{ size_chart_measure_image_pc }}" alt="{{ size_chart_measure_image_alt | escape }}" width="770" height="163" loading="lazy" decoding="async">
                    </picture>
                    <ul class="size-chart__tips">
                      {% for size_chart_tip in size_chart_tips %}
                        <li>{{ size_chart_tip }}</li>
                      {% endfor %}
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="sp2__pain">
          <div class="sp2__pain-heading">
            <h2>{{ pain_title }}</h2>
            <p>{{ pain_subtitle }}</p>
          </div>
          <ul class="sp2__pain-grid" aria-label="Señales comunes de tensión diaria en los pies">
            {% for pain_label in pain_labels %}
              {% assign pain_index = forloop.index0 %}
              <li class="sp2__pain-card sp2__pain-card--{{ forloop.index }}">
