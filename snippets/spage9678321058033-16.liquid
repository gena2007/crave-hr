                {{ sp_sale_prefix }}&nbsp;<span class="js-bind-save-amount"></span>
              </div>

              <div class="sp-price-group js-price-group">
                {%- liquid
                  assign sp_price = page_discount_price
                  assign sp_compare = page_discount_compare
                  assign sp_off = page_discount_percent
                -%}

                <div class="sp-price1">
                  <span class="sp-span js-bind-price">{{ sp_price | money }}</span>
                </div>

                <div class="sp-price2">
                  <span class="js-bind-compare">
                    {%- if sp_compare > sp_price %}{{ sp_compare | money }}{% else %}{{ sp_price | money }}{% endif -%}
                  </span>
                </div>

                <div class="sp-row sp-uppercase" aria-hidden="true">
                  <p class="sp-p">
                    <span class="js-bind-discount-percent">{{ sp_off }}%</span>
                    {{ sp_discount_label }}
                  </p>
                </div>
              </div>

              <div class="sp-options-card sp-padding">
                {%- unless product.has_only_default_variant -%}
                  {%- for option in product.options_with_values -%}
                    <div class="js-option-heading">
                      <div class="option-title">
                        {%- if option.position == 2 -%}{{ sp_size_label }}{%- else -%}{{ option.name | escape }}{%- endif -%}:
                        {%- if forloop.first -%}
                          <span class="js-option-current" data-sp-option-current="{{ forloop.index0 }}">{{ option.selected_value | default: option.values.first | escape }}</span>
                        {%- endif -%}
                      </div>
                    </div>

                    <div
                      class="js-opt-group{% if option.position == 1 %} sp-color-options{% else %} sp-size-options{% endif %}"
                      data-option-index="{{ forloop.index0 }}"
                      data-option-name="{{ option.name | escape }}"
                    >
                      {%- for value in option.values -%}
                        {%- liquid
                          assign is_active = false
                          if option.selected_value == value
                            assign is_active = true
                          elsif option.selected_value == blank and forloop.first
                            assign is_active = true
                          endif
                        -%}

                        <button
                          type="button"
                          class="js-option{% if is_active %} active{% endif %}{% if option.position == 1 %} js-option-swatch{% endif %}"
                          data-val="{{ value | escape }}"
                          data-option-position="{{ option.position }}"
                        >
                          {%- if option.position == 1 -%}
                            {%- assign option_variant = product.variants | where: 'option1', value | first -%}
                            {%- if option_variant.featured_image -%}
                              <img src="{{ option_variant.featured_image | image_url: width: 220 }}" alt="{{ value | escape }}" width="180" height="180">
                              <span class="visually-hidden">{{ value | escape }}</span>
                            {%- else -%}
                              {{ value | escape }}
                            {%- endif -%}
                          {%- else -%}
                            {{ value | escape }}
                          {%- endif -%}
                        </button>
                      {%- endfor -%}
                    </div>
                  {%- endfor -%}

