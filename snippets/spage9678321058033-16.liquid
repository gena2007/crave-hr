          assign size_chart_notice_title = 'Brinete se da vam veličina možda neće odgovarati?'
          assign size_chart_notice_description = 'Ne brinite — jamčimo 90-dnevno besplatno probno razdoblje, a ako vam ne odgovaraju, možete ih besplatno vratiti ili zamijeniti.'
        %}
