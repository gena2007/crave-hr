                <img class="sp-trust-icon" src="{{ sp_guarantee_service_images[forloop.index0] }}" alt="" width="62" height="62" loading="lazy" aria-hidden="true">
                <strong class="sp-trust-title">{{ sp_guarantee_service_title }}</strong>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </section>

      {% comment %}
