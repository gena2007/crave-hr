            <h2>{{ sp_guarantee_title }}</h2>
            <img class="sp-trust-heading-icon sp-trust-heading-icon--right" src="{{ sp_guarantee_emoji_right }}" alt="" width="46" height="44" loading="lazy" aria-hidden="true">
          </div>

