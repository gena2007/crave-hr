                      <img
                        src="{{ image | image_url: width: 240 }}"
                        alt="{{ image.alt | default: product.title | escape }}"
                        width="120"
                        height="120"
                      >
                    </button>
                  {%- endfor -%}
                </div>

                <button class="sp-thumb-prev js-thumb-prev" type="button" aria-label="Poprzednie miniatury">
