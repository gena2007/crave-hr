          <h2 class="size-chart__title reveal-on-scroll">{{ size_chart_title }}</h2>

          <div class="size-chart__content">
            <div class="size-chart__table-panel">
              <div class="size-chart__table-wrap reveal-on-scroll">
                <table class="size-chart__table">
                  <thead>
                    <tr>
                      <th scope="col">{{ size_chart_eu_label }}</th>
                      <th scope="col">
                        <span class="size-chart__pc-label">{{ size_chart_length_label }}</span>
                        <span class="size-chart__mobile-label">
                          <span class="size-chart__mobile-length-main">{{ size_chart_mobile_length_label }}</span>
                          <span class="size-chart__mobile-length-unit">{{ size_chart_unit_label }}</span>
