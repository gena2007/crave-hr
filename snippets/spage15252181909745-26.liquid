      {% comment %} 尺寸弹窗 {% endcomment %}
      <div class="sp-size-modal" data-sp-size-modal aria-hidden="true">
        <div class="sp-size-modal__overlay" data-sp-size-close></div>
        <div class="sp-size-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="sp-size-modal-title">
          <button
            class="sp-size-modal__close"
            type="button"
            data-sp-size-close
            aria-label="Zatvori vodič za veličinu"
          >
            ×
          </button>
          <h2 id="sp-size-modal-title">Tablica veličina</h2>
          <div class="sp-size-modal__table-wrap">
            <section class="lp-size">
        <div class="lp-size__inner">
          <div class="lp-size__main">
            <div class="lp-size__table-wrap reveal-on-scroll is-visible">
              <table class="lp-size__table">
                <thead>
                  <tr>
                    <th>EU</th>
                    <th>Duljina <span>(mm)</span></th>
                    <th>EU</th>
                    <th>Duljina <span>(mm)</span></th>
                  </tr>
                </thead>
                <tbody>
                  <tr><td>36</td><td>230</td><td>45</td><td>275</td></tr>
                  <tr><td>37</td><td>235</td><td>46</td><td>280</td></tr>
                  <tr><td>38</td><td>240</td><td>47</td><td>285</td></tr>
                  <tr><td>39</td><td>245</td><td>48</td><td>290</td></tr>
                  <tr><td>40</td><td>250</td><td>49</td><td>295</td></tr>
                  <tr><td>41</td><td>255</td><td>50</td><td>300</td></tr>
                  <tr><td>42</td><td>260</td><td>51</td><td>305</td></tr>
                  <tr><td>43</td><td>265</td><td>52</td><td>310</td></tr>
                  <tr><td>44</td><td>270</td><td>53</td><td>315</td></tr>
                </tbody>
              </table>
            </div>

            <div class="lp-size__aside reveal-on-scroll is-visible">
              <div class="lp-size__guarantee">
                <img
                  class="lp-size__guarantee-img"
                  src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_banner_30-day.webp?v=1791874468"
                  alt="30 dana jamstva povrata novca"
                  width="92"
                  height="92"
                  loading="lazy"
                  decoding="async"
                >
                <div class="lp-size__guarantee-text">
                  <strong>Zabrinuti ste da veličina možda ne odgovara?</strong>
                  <p class="lp-size__guarantee-copy--pc stext2">Bez brige - imate 30 dana da ih isprobate. Ako veličina ne odgovara, povrat i zamjena su besplatni.</p>
                  <p class="lp-size__guarantee-copy--mb stext2">Ne brinite - nudimo 30-dnevno jamstvo za prilagodbu. Ako ne odgovaraju, možete ih besplatno vratiti ili zamijeniti.</p>
                </div>
              </div>

              <picture class="lp-size__measure">
                <source
                  media="(min-width: 768px)"
                  srcset="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105674-measurement.webp?v=1787552916"
                >
                <img
                  src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105674-measurement-mb.webp?v=1787552916"
                  alt="Kako izmjeriti veličinu stopala"
                  width="640"
                  height="360"
                  loading="lazy"
                  decoding="async"
                >
              </picture>

              <ul class="lp-size__tips stext2">
                <li>Nosite čarape i stojte prirodno tijekom mjerenja.</li>
                <li>Dopustite varijaciju mjerenja od 0,3 do 0,5 cm.</li>
                <li>Odaberite veću veličinu ako je između veličina.</li>
              </ul>
            </div>
          </div>

        </div>
      </section>
          </div>
        </div>
      </div>

      {% comment %} 购物车底部加购模块 {% endcomment %}
      <div class="sp-shopping-drawer">
        <div class="sp-cart-drawer-overlay" data-sp-drawer-overlay aria-hidden="true"></div>
        <aside class="sp-cart-drawer" data-sp-cart-drawer aria-hidden="true" aria-label="Košarica za kupovinu">
          <div class="sp-cart-drawer__header">
            <h2 class="sp-cart-drawer__heading">Košarica ( <span class="js-cardNum">0</span> )</h2>
            <button
              class="sp-cart-drawer__close"
              type="button"
              data-sp-drawer-close
              aria-label="Zatvorite košaricu"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
            </button>
          </div>

          <div class="sp-cart-drawer__notice">✓ Sigurno plaćanje · Brza dostava · Jednostavan povrat</div>

          <div class="sp-cart-drawer__body">
            <div class="sp-cart-drawer__loading" data-sp-cart-loading>Učitavanje vaše košarice…</div>

            <div class="sp-cart-drawer__empty" data-sp-cart-empty>
              <div class="sp-cart-drawer__empty-icon">🛒</div>
              <p>Vaša košarica je trenutno prazna.</p>
              <button class="sp-cart-drawer__continue" type="button" data-sp-drawer-close>Nastavite kupovati</button>
            </div>

            <div class="sp-cart-drawer__items" data-sp-cart-items aria-live="polite"></div>
          </div>

          <div class="sp-cart-drawer__footer" data-sp-cart-footer hidden>
            <div class="sp-cart-drawer__note js-cart-drawer__note">
              <button
                class="sp-cart-drawer__note-toggle"
                type="button"
                aria-expanded="false"
                aria-controls="sp-cart-note-panel"
                data-sp-cart-note-toggle
              >
                <span data-sp-cart-note-toggle-label>Dodajte napomenu o narudžbi</span>
                <span class="sp-cart-drawer__note-chevron" aria-hidden="true">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10 6l-1.41 1.41L13.17 12l-4.58 4.59L10 18l6-6z" fill="#000"></path>
                  </svg>
                </span>
              </button>
              <div class="sp-cart-drawer__note-panel" id="sp-cart-note-panel" data-sp-cart-note-panel hidden>
                {% comment %} <label class="sp-cart-drawer__note-label" for="sp-cart-note">Order note</label> {% endcomment %}
                <textarea
                  class="sp-cart-drawer__note-input"
                  id="sp-cart-note"
                  maxlength="500"
                  placeholder="Dodajte upute za dostavu ili napomenu o svojoj narudžbi"
                  data-sp-cart-note
                ></textarea>
                <div class="sp-cart-drawer__note-actions">
                  <span class="sp-cart-drawer__note-status" data-sp-cart-note-status aria-live="polite"></span>
                  <button class="sp-cart-drawer__note-save" type="button" data-sp-cart-note-save>Spremi bilješku</button>
                </div>
              </div>
            </div>
            <div class="sp-cart-drawer__subtotal">
              <span>Međuzbroj</span>
              <span class="sp-cart-drawer__subtotal-value" data-sp-cart-total></span>
            </div>
            <p class="sp-cart-drawer__tax-note">Porezi i poštarina obračunavaju se prilikom naplate.</p>
            <a class="sp-cart-drawer__checkout js-cart-drawer__checkout" href="/checkout">Sigurna naplata</a>
          </div>
        </aside>
      </div>
      <!-- 页面底部加购模块 -->
      <div class="sp-fixed-purchase-mount">
        <section class="sp-fixed-purchase" data-sp-fixed-purchase aria-label="Brza kupnja">
          <div class="sp-fixed-purchase__inner">
            <div class="sp-fixed-purchase__product">
              {%- assign sp_fixed_product_image = product.selected_or_first_available_variant.featured_image
                | default: product.featured_image
              -%}
              {%- if sp_fixed_product_image -%}
                {%- assign sp_fixed_product_image_url = sp_fixed_product_image
                  | image_url: width: sp_fixed_product_image.width
                  | split: '&width='
                  | first
                -%}
              {%- else -%}
                {%- assign sp_fixed_product_image_url = '' -%}
              {%- endif -%}
              <img
                class="sp-fixed-purchase__image js-bind-image"
                src="{{ sp_fixed_product_image_url }}"
                alt="{{ product.title | escape }}"
                width="80"
                height="80"
              >
              <div class="sp-fixed-purchase__meta">
                <p class="sp-fixed-purchase__title js-bind-title">{{ product.title }}</p>
                <div class="sp-fixed-purchase__prices">
                  <span class="sp-fixed-purchase__price js-bind-price"></span>
                  <span class="sp-fixed-purchase__compare js-bind-compare"></span>
                </div>
              </div>
            </div>

            {%- unless product.has_only_default_variant -%}
              <div class="sp-fixed-purchase__options">
                {%- for option in product.options_with_values -%}
                  <select
                    class="sp-fixed-purchase__select js-variant-select"
                    data-option-index="{{ forloop.index0 }}"
                    aria-label="{{ option.name | escape }}"
                  >
                    <option value="" selected>{{ option.name | escape }}</option>
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}">
                        {{ value | escape }}
                      </option>
                    {%- endfor -%}
                  </select>
                {%- endfor -%}
              </div>
            {%- endunless -%}

            <div class="sp-fixed-purchase__actions">
              <div class="sp-fixed-purchase__qty" aria-label="Količina">
                <button class="js-reduce" type="button" aria-label="Smanjite količinu">−</button>
                <input
                  class="js-calcNumber"
                  type="number"
                  min="1"
                  max="200"
                  value="1"
                  inputmode="numeric"
                  aria-label="Količina"
                >
                <button class="js-add" type="button" aria-label="Povećajte količinu">+</button>
              </div>

              <button
                class="sp-fixed-purchase__cart js-fixed-purchase__cart js-add-cart"
                type="button"
                aria-label="Dodaj u košaricu"
              >
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d="M3 4h2l2.2 10.1a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 1.9-1.4L21 7H6M10 20a1 1 0 1 1-2 0 1 1 0 0 1 2 0Zm9 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z"
                    stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="js-cardNum{% if cart.item_count < 1 %} sp-gray{% endif %}">{{ cart.item_count }}</span>
              </button>

              <button class="sp-fixed-purchase__buy js-buy-now" type="button">NARUČITE ODMAH</button>
            </div>
          </div>
        </section>
      </div>
      {% comment %} 回到顶部 {% endcomment %}
      <button class="sp-to-top" type="button" aria-label="Povratak na vrh" title="Povratak na vrh" >
        <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-25-YH008260_arrow-icon1.svg?v=1792402546" alt="" width="20" height="20">
      </button>
    </div>

    {% comment %} 产品需要的数据 {% endcomment %}
    <script>
      window.product = {{ product.variants | json }}; {% comment %} 产品数据 {% endcomment %}
      window.options = {{ product.options_with_values | json }}; {% comment %} 产品选项数据 {% endcomment %}
      window.cartCount = {{ cart.item_count | json }}; {% comment %} 购物车数量 {% endcomment %}
      window.shopMoneyFormat = {{ shop.money_format | json }}; {% comment %} 商店货币格式 {% endcomment %}
      window.spCurrencyCode = {{ cart.currency.iso_code | default: localization.country.currency.iso_code | json }}; {% comment %} 商店货币代码 {% endcomment %}
      window.spLocale = "hr"; {% comment %} 商店语言代码 {% endcomment %}
      window.spSelectedVariantId = {{ product.selected_or_first_available_variant.id | json }}; {% comment %} 产品选定变体ID {% endcomment %}
      window.spProductTitle = {{ product.title | json }}; {% comment %} 产品标题 {% endcomment %}
    </script>

    <script src="{{ 'jquery.min.js' | asset_url }}" defer></script>
    <script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
    <script src="https://cdn.shopify.com/s/files/1/0807/0086/6801/files/ID-26-YH008260-HR_2.js?v=1792653132" defer></script>
    
  </body>
</html>
