<!doctype html>
<html lang="hr">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ product.title }}</title>
  </head>
  <body>
    {{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
    <link rel="stylesheet" href="https://cdn.shopify.com/s/files/1/0807/0086/6801/files/ID-26-YH008260-HR_2.css?v=1792653134">
    
    {%- liquid
      assign sp_initial_variant = product.selected_or_first_available_variant
      assign sp_price = sp_initial_variant.price | default: product.price
      assign sp_compare = sp_initial_variant.compare_at_price | default: sp_price
    -%}
    {% comment %} 落地页内容 {% endcomment %}
    <div
      id="root"
      data-page-id="ID-26-YH008260-HR-G206"
      style="
        --wrapper-mw:1232px;
        --primary-color:#F58625;
        --text-color:#0D2638;
        --gray-color:#4D4D4D;
        --module-padding:50px 16px;
        --secondary-color: #EFF7FF;
        --third-color: #FF0000;
        --btn-color:#fff;
        --btn-bg-color:var(--primary-color);
      "
    >

      {% comment %} 公告栏 {% endcomment %}
      {%- capture sp_announcement_content -%}
        <p class="announcement-bar-w__text">
          <span class="announcement-bar-w__intro">Vremenski ograničeni program podrške rehabilitaciji:</span>
          <strong class="announcement-bar-w__offer">uštedite do <span class="js-bind-discount-percent">60%</span> danas · 30-dnevno probno razdoblje bez rizika</strong>
        </p>
      {%- endcapture -%}
      <div class="announcement-bar-w common-pc--hide">
        {{ sp_announcement_content }}
      </div>

      {% comment %} 头部 {% endcomment %}
        <div class="announcement-bar-w common-mb--hide">
          {{ sp_announcement_content }}
        </div>
      <section class="sph" id="sp-shopping-header" data-sp-header aria-label="Zaglavlje stranice">
        {%- liquid
          assign sph_logo = logo | default: '' | strip
          if sph_logo == blank and settings.logo != blank
            assign sph_logo = settings.logo | image_url: width: 600
          endif
          if sph_logo == blank
            assign sph_logo = 'https://cdn.shopify.com/s/files/1/0688/0460/8043/files/6888a41632338a4443544e81_EMSense_20logo.svg?v=1791771380'
          endif
        -%}
        <div class="sph__bar">
          <div class="sph__inner ">
            <div class="sph__left">
              <a
                class="sph__logo sph__scroll"
                href="{{ routes.root_url }}"
                aria-label="{{ shop.name | escape }}"
              >
                <img
                  src="{{ sph_logo }}"
                  alt="{{ shop.name | escape }}"
                  width="178"
                  height="48"
                  loading="eager"
                  decoding="async"
                >
              </a>
              <span class="sph__sep" aria-hidden="true"></span>
              <span class="sph__tagline">Plaćanje pouzećem</span>
            </div>

            <div class="sph__right">
              <nav class="sph__nav" aria-label="Navigacija odjeljcima">
                <button class="sph__nav-link js-size-guide" type="button">
                  <img class="sph__nav-icon" src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_size-chart.svg?v=1791863371" alt="" width="24" height="24">
                  <span>Tablica veličina</span>
                </button>
                <a class="sph__nav-link sph__scroll" href="#bewertungen" data-sph-target="bewertungen">
                  <img class="sph__nav-icon" src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_reviews.svg?v=1791863371" alt="" width="24" height="24">
                  <span>Recenzije</span>
                </a>
               
                <a class="sph__nav-link sph__scroll" href="#faq" data-sph-target="faq">
                  <img class="sph__nav-icon" src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_faq.svg?v=1791863371" alt="" width="24" height="24">
                  <span>FAQ</span>
                </a>
              </nav>

              <button class="sph__cart js-cart" type="button" aria-label="Otvorite košaricu">
                <svg class="sph__cart-icon sph__cart-icon--pc" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16l1 13H3L4 7Zm4 0V5a4 4 0 0 1 8 0v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <img class="sph__cart-icon sph__cart-icon--mb" src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_cart.svg?v=1791863579" alt="" width="28" height="28">
                <span class="text">KOŠARICA</span>
                <span class="sph__cart-count js-cardNum{% if cart.item_count < 1 %} sp-gray{% endif %}">
                  {{- cart.item_count -}}
                </span>
              </button>

              <a class="sph__cta sph__scroll" href="#shopping" data-sph-target="shopping">
                <span>KUPITE SADA</span>
              </a>

              <button
                type="button"
                class="sph__menu-toggle js-header-menu-btn"
                aria-label="Otvorite navigacijski izbornik"
                aria-expanded="false"
                aria-controls="sph-drawer"
              >
                <img class="sph__menu-icon" src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_menu.svg?v=1791863579" alt="" width="27" height="24">
              </button>
            </div>
          </div>
        </div>

        <div class="sph__drawer-backdrop js-header-menu-btn" data-header-menu aria-hidden="true"></div>
        <aside class="sph__drawer" id="sph-drawer" data-header-menu aria-hidden="true" inert role="dialog" aria-modal="true" aria-labelledby="sph-drawer-title">
          <div class="sph__drawer-head">
            <strong id="sph-drawer-title">Jelovnik</strong>
            <button type="button" class="sph__drawer-close js-header-menu-btn" aria-label="Zatvorite navigacijski izbornik">
              ×
            </button>
          </div>
          <nav class="sph__drawer-nav" aria-label="Mobilna navigacija">
            <button class="sph__drawer-link js-size-guide" type="button" data-sp-header-menu-close>
              <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_size-chart.svg?v=1791863371" alt="" width="20" height="20">
              <span>Tablica veličina</span>
            </button>
            <a class="sph__drawer-link sph__scroll" href="#bewertungen" data-sph-target="bewertungen" data-sp-header-menu-close>
              <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_reviews.svg?v=1791863371" alt="" width="20" height="20">
              <span>Recenzije</span>
            </a>
            <a class="sph__drawer-link sph__scroll" href="#faq" data-sph-target="faq" data-sp-header-menu-close>
              <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_faq.svg?v=1791863371" alt="" width="20" height="20">
              <span>FAQ</span>
            </a>
            <button class="sph__drawer-link js-cart" type="button" data-sp-header-menu-close>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16l1 13H3L4 7Zm4 0V5a4 4 0 0 1 8 0v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span
                >Košarica ( <span class="js-cardNum">{{ cart.item_count }}</span> )</span
              >
            </button>
            <a class="sph__drawer-link sph__drawer-buy sph__scroll" href="#shopping" data-sph-target="shopping" data-sp-header-menu-close>KUPITE SADA</a>
          </nav>
        </aside>
      </section>

      {% comment %} 首屏介绍 {% endcomment %}
      <section class="lp-hero" id="produkt">
        <div class="lp-shell lp-hero__inner">
          <div class="lp-hero__media reveal-on-scroll">
            <div class="lp-hero__video-wrap" data-sp-hero-video-wrap>
              <video class="lp-hero__video" data-sp-hero-video autoplay muted loop playsinline preload="metadata" poster="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-25-YH008260_banner-video_poster.webp?v=1792402325" aria-label="Demonstracija ružičastih ortopedskih cipela za hodanje">
                <source src="https://cdn.shopify.com/videos/c/o/v/f37c4f96bf864c57b19681477e96e620.webm" type="video/webm">
              </video>
              <button class="lp-hero__play" type="button" data-sp-hero-play aria-label="Reproducirajte video o proizvodu"><span aria-hidden="true">▶</span></button>
            </div>
          </div>
          <div class="lp-hero__copy">
            <div class="lp-hero__expert">
              <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-25-YH008260_banner_doctor.webp?v=1792402490" alt="" width="32" height="32" loading="eager">
              <span>Preporučuju <strong>stručnjaci za njegu stopala</strong></span>
            </div>
            <h1 class="lp-hero__title">Moderan dizajn skriva modernu znanost o stopalima!*</h1>
            <div class="lp-hero__lead">
              <p>Proboj koji ublažava udarce pomaže Europljanima da hodaju s manje boli u stopalima. Ugrađena u ortopedske cipele za hodanje, peta sa zračnim jastukom ublažava svaki udarac, dok ciljana potpora svoda i stabilan potplat ublažavaju pritisak. Rezultat: dobrodošlo ublažavanje bolova u stopalima u stilu stvorenom za svakodnevni život.</p>
            </div>
            <ul class="lp-check-list">
              <li><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_banner_arch-support.webp?v=1791874144" alt="" width="37" height="29"><span><strong>Potpora svodu stopala</strong> liječi plantarni fasciitis i ublažava kroničnu bol u peti.*</span></li>
              <li><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_banner_wide-toe.webp?v=1791874143" alt="" width="37" height="29"><span><strong>Prostrani prednji dio cipele</strong> liječi čukljeve i vraća prirodan položaj nožnih prstiju.*</span></li>
              <li><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_banner_flexible-sole.webp?v=1791874143" alt="" width="37" height="29"><span><strong>Amortizacija pete</strong> apsorbira udarce i pomaže smanjiti opterećenje pri svakom koraku.*</span></li>
            </ul>
            <a class="common-button lp-cta lp-hero__cta" href="#shopping">
              <span class="lp-hero__cta-box">
                <span class="lp-hero__cta-label"><span class="js-bind-discount-percent">70%</span> POPUŠTENO SAMO DANAS!</span>
              <img class="lp-hero__cta-arrow" src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-25-YH008260_arrow-icon1.svg?v=1792402546" alt="" width="42" height="42">
              </span>
            </a>
            <div class="lp-hero__purchase-info">
              <div class="lp-hero__prices"><span class="lp-hero__compare js-bind-compare">€122,00 EUR</span><strong class="lp-hero__price js-bind-price">€50,00 EUR</strong></div>
              <div class="lp-hero__urgency"><strong>POVRATAK NA PUNU CIJENU SUTRA</strong><span class="lp-hero__inventory"><img class="lp-hero__inventory-icon" src="https://cdn.shopify.com/s/files/1/0990/0215/5371/files/icons8-_-96.apng?v=1783565616" alt="" width="18" height="18" loading="eager"><span>Trenutne zalihe: <strong>Još samo 9 pari!</strong></span></span></div>
            </div>
          </div>
        </div>

        <div class="lp-shell lp-benefits reveal-on-scroll">
          <article class="lp-benefit">
            <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_banner_30-day.webp?v=1791874468" alt="" width="96" height="96" loading="lazy">
            <div><h3>30-dnevni povrat novca</h3><p>Uvjereni smo da će vam se svidjeti—isprobajte bez rizika 30 dana ili zatražite puni povrat novca.</p></div>
          </article>
          <article class="lp-benefit">
            <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_banner_tracked-worldwide.webp?v=1791874468" alt="" width="96" height="96" loading="lazy">
            <div><h3>Praćena dostava diljem svijeta</h3><p>Svaka narudžba uključuje praćenje u stvarnom vremenu i osiguranje od gubitka ili krađe u transportu.</p></div>
          </article>
          <article class="lp-benefit">
            <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_banner_powered-real.webp?v=1791874468" alt="" width="96" height="96" loading="lazy">
            <div><h3>Pokreću stvarni korisnici</h3><p>Stvarno korisničko iskustvo pokreće naš razvoj i testiranje kako bismo stvorili vrhunsko rješenje.</p></div>
          </article>
        </div>
      </section>

      {% comment %} 四项步行鞋优势 {% endcomment %}
      <section class="lp-core-benefits" aria-labelledby="lp-core-benefits-title">
        <div class="lp-core-benefits__inner">
          <h2 class="lp-core-benefits__title reveal-on-scroll" id="lp-core-benefits-title">Što ovaj par čini tako nevjerojatno drugačijim?</h2>
          <div class="lp-core-benefits__grid">
            <article class="lp-core-benefits__card reveal-on-scroll">
              <video class="lp-core-benefits__image js-lazy-video" poster="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-25-YH008260_sp1_1_poster_1.webp?v=1792468192" width="290" height="290" muted loop playsinline preload="none" aria-label="Prikaz liječenja petnih trnova">
                <source data-src="https://cdn.shopify.com/videos/c/o/v/bb16b6a9f73d4ed1baeb0a78ebbf9b26.webm" type="video/webm">
              </video>
              <div class="lp-core-benefits__body">
                <h3 class="lp-core-benefits__heading"><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-25-YH008260_correct.svg?v=1792467486" alt="" width="20" height="20" loading="lazy"><span>Liječi petne trnove</span></h3>
                <p class="lp-core-benefits__description">Duboka amortizacija pete liječi petne trne dok apsorbira jake udarce ispod osjetljive petne kosti.*</p>
              </div>
            </article>
            <article class="lp-core-benefits__card reveal-on-scroll">
              <video class="lp-core-benefits__image js-lazy-video" poster="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-25-YH008260_sp1_2_poster_1.webp?v=1792468192" width="290" height="290" muted loop playsinline preload="none" aria-label="Prikaz obnove potpore tabanu">
                <source data-src="https://cdn.shopify.com/videos/c/o/v/e72d8e3950dc440dab1904f9fd1a0c77.webm" type="video/webm">
              </video>
              <div class="lp-core-benefits__body">
                <h3 class="lp-core-benefits__heading"><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-25-YH008260_correct.svg?v=1792467486" alt="" width="20" height="20" loading="lazy"><span>Obnavlja potporu tabanu</span></h3>
                <p class="lp-core-benefits__description">Pojačani luk liječi plantarni fasciitis i vraća stabilnu potporu cijelom stopalu.*</p>
              </div>
            </article>
            <article class="lp-core-benefits__card reveal-on-scroll">
              <video class="lp-core-benefits__image js-lazy-video" poster="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-25-YH008260_sp1_3_poster_1.webp?v=1792468191" width="290" height="290" muted loop playsinline preload="none" aria-label="Prikaz liječenja čukljeva">
                <source data-src="https://cdn.shopify.com/videos/c/o/v/9ea91d4f5519431ba6d3428949236d83.webm" type="video/webm">
              </video>
              <div class="lp-core-benefits__body">
                <h3 class="lp-core-benefits__heading"><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-25-YH008260_correct.svg?v=1792467486" alt="" width="20" height="20" loading="lazy"><span>Liječi čukljeve</span></h3>
                <p class="lp-core-benefits__description">Prostrani prednji dio cipele vraća prirodan položaj prstiju i liječi bolne čukljeve bez neugodnog stiskanja.*</p>
              </div>
            </article>
            <article class="lp-core-benefits__card reveal-on-scroll">
              <video class="lp-core-benefits__image js-lazy-video" poster="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-25-YH008260_sp1_4_poster_1.webp?v=1792468191" width="290" height="290" muted loop playsinline preload="none" aria-label="Prikaz sprječavanja ponovnih ozljeda">
                <source data-src="https://cdn.shopify.com/videos/c/o/v/1df1907ae4264e0ea2441e34a92f838b.webm" type="video/webm">
              </video>
              <div class="lp-core-benefits__body">
                <h3 class="lp-core-benefits__heading"><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-25-YH008260_correct.svg?v=1792467486" alt="" width="20" height="20" loading="lazy"><span>Sprječava ponovne ozljede</span></h3>
                <p class="lp-core-benefits__description">Stabilizacija od pete do prstiju sprječava ponovne ozljede ispravljanjem nestabilnih pokreta i neusklađenosti tijekom svakog koraka.*</p>
              </div>
            </article>
          </div>
        </div>
      </section>    {% comment %} Fußschmerzen Ursache {% endcomment %}
      <section class="lp-cause" id="ergebnisse">
        <div class="lp-shell">
          <div class="lp-split lp-split--media-left">
            <video class="lp-media reveal-on-scroll" data-sp-cause-video poster="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-25-YH008260_sp2_video_poster.webp?v=1792477933" data-poster-pc="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-25-YH008260_sp2_video_poster.webp?v=1792477933" data-poster-mb="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-25-YH008260_sp2_video_poster_mb.webp?v=1792477934" width="599" height="579" autoplay muted loop playsinline preload="metadata">
              <source src="https://cdn.shopify.com/videos/c/o/v/49043fba2cce4b748bc9b47ccdd6d68f.webm" type="video/webm">
            </video>
            <div class="lp-rich-text stext2">
              <h2 class="lp-cause__title stitle2 reveal-on-scroll">Zašto se bol u prednjem dijelu stopala stalno vraća</h2>
              <p>Vaše prednje stopalo <strong>podnosi težak pritisak</strong> svaki put kada stojite, hodate ili se gurate prema naprijed—iznova i iznova, iz dana u dan.</p>
              <p>Kada se ta sila koncentrira ispod metatarzalnih kostiju, okolna tkiva mogu postati <strong>upaljena, nadražena</strong> i <strong>sve više bolna.</strong></p>
              <p>Ono što počinje kao blaga nelagoda može prerasti u žarenje, probadanje ili nemilosrdnu bol - kao da <strong>svaki korak pada na oštar kamen.</strong></p>
              <p>Što se dulje ignoriraju ovi znakovi upozorenja, to može biti teže <strong>ponovno udobno hodati.*</strong></p>
              <p>Ali ne brinite…</p>
              <a class="lp-solution stexts2" href="#shopping">
                <span>PRONAŠLI SMO RJEŠENJE!</span>
                <span class="lp-solution__arrow" aria-hidden="true"></span>
              </a>
            </div>
          </div>
          <div class="lp-stat-grid reveal-on-scroll">
            <article class="lp-stat-card" data-sp-stat-wrap>
              <div class="lp-stat-ring">
                <svg viewBox="0 0 120 120" aria-hidden="true">
                  <circle class="lp-stat-ring__track" cx="60" cy="60" r="52"></circle>
                  <circle class="lp-stat-ring__progress js-stat-progress" cx="60" cy="60" r="52" data-sp-stat-radius="52"></circle>
                </svg>
                <strong class="lp-stat-ring__value stitle2"><span class="js-stat-num" data-sp-stat-value="96">0</span><span class="lp-stat-percent">%</span></strong>
              </div>
              <p class="stexts2">ispitanih odraslih osoba osjeti ukočenost stopala odmah nakon odmora.*</p>
            </article>
            <article class="lp-stat-card" data-sp-stat-wrap>
              <div class="lp-stat-ring">
                <svg viewBox="0 0 120 120" aria-hidden="true">
                  <circle class="lp-stat-ring__track" cx="60" cy="60" r="52"></circle>
                  <circle class="lp-stat-ring__progress js-stat-progress" cx="60" cy="60" r="52" data-sp-stat-radius="52"></circle>
                </svg>
                <strong class="lp-stat-ring__value stitle2"><span class="js-stat-num" data-sp-stat-value="91">0</span><span class="lp-stat-percent">%</span></strong>
              </div>
              <p class="stexts2">kažu da bolni zglobovi otežavaju stepenice i duže hodanje.*</p>
            </article>
            <article class="lp-stat-card" data-sp-stat-wrap>
              <div class="lp-stat-ring">
                <svg viewBox="0 0 120 120" aria-hidden="true">
                  <circle class="lp-stat-ring__track" cx="60" cy="60" r="52"></circle>
                  <circle class="lp-stat-ring__progress js-stat-progress" cx="60" cy="60" r="52" data-sp-stat-radius="52"></circle>
                </svg>
                <strong class="lp-stat-ring__value stitle2"><span class="js-stat-num" data-sp-stat-value="84">0</span><span class="lp-stat-percent">%</span></strong>
              </div>
              <p class="stexts2">prijavite oticanje oko nožnih prstiju ili gležnjeva nakon dnevne aktivnosti.*</p>
            </article>
            <article class="lp-stat-card" data-sp-stat-wrap>
              <div class="lp-stat-ring">
