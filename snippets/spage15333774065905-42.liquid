              <div class="sp-sale-pill stexts2">{{ sp_product_sale_text }} &nbsp;<span class="js-bind-save-amount"></span></div>
              <div class="sp-price-group js-price-group">
                {%- liquid
                  assign sp_variant = product.selected_or_first_available_variant
                  assign sp_price = sp_variant.price
                  assign sp_compare = sp_variant.compare_at_price
                  assign sp_off = 0
                  if sp_compare > sp_price and sp_compare > 0
                    assign sp_off = sp_compare | minus: sp_price | times: 100.0 | divided_by: sp_compare | ceil
                  endif
                -%}
                <div class="sp-price1">
                  <span class="sp-span js-bind-price stitle2">{{ sp_price | money }}</span>
                </div>
                <div class="sp-price2">
                  <span class="js-bind-compare stext20">
                    {%- if sp_compare > sp_price %}{{ sp_compare | money }}{% else %}{{ sp_price | money }}{% endif -%}
                  </span>
                </div>
                <div class="sp-row sp-uppercase">
                  <img
                    alt=""
                    decoding="async"
                    loading="lazy"
                    srcset="https://cdn.shopify.com/s/files/1/0826/5669/0478/files/20260105-down.png"
                  >
                  <p class="sp-p">
                    <span class="js-bind-discount-percent">{{ sp_off }}%</span>
                    {{ sp_product_discount_text }}
                  </p>
                </div>
              </div>
              <p class="sp-tax-note stext20">{{ sp_product_tax_text }}</p>
