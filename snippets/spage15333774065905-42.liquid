<!doctype html>
<html lang="en" dir="ltr">
  <body>

    {{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
    <link rel="stylesheet"  href="https://cdn.shopify.com/s/files/1/0807/0086/6801/files/spage-YH108359-42-HR_bb7627a3-0f23-4240-b397-6d73ce2f3fc2.css?v=1795422322" >

    {% liquid
      assign cdn_img = 'https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105489_42_'
      assign save_up_to_btn = 'Provjerite dostupnost'
      assign buy_now_btn = 'Kupite sada'
      assign discount_btn = 'OSTVARITE &nbsp;<span class="js-bind-discount-percent">60%</span>&nbsp; POPUSTA'
    %}

    {% comment %} 落地页内容 {% endcomment %}
    <div
      id="root"
      data-page-id="YH108359-42-EN" 
      style="
        --wrapper-mw:1600px;
        --primary-color:#00AB84;
        --secondary-color: #F0FCFA;
        --third-color: #EFEFEF;
        --btn-color:#fff;
        --btn-bg-color:#00AB84;
        max-width: 1920px;
        margin:0 auto;
      "
    >
      {% comment %} 头部 {% endcomment %}
    {%- liquid
      assign sph_tagline = tagline | default: 'Plaćanje pouzećem / brza dostava'
      assign sph_nav_text = nav_text | default: 'Tablica veličina|||Recenzije|||Česta pitanja' | split: '|||'
      assign sph_nav_target = nav_target | default: 'size|||reviews|||faq' | split: '|||'
      assign sph_nav_icon = nav_icon | default: 'https://cdn.shopify.com/s/files/1/0991/9614/1880/files/size.png?v=1777014292|||https://cdn.shopify.com/s/files/1/0991/9614/1880/files/comment.png?v=1777014292|||https://cdn.shopify.com/s/files/1/0991/9614/1880/files/faq.png?v=1777014292' | split: '|||'

      assign sph_logo = logo | default: '' | strip
      if sph_logo == blank and settings.logo != blank
        assign sph_logo = settings.logo | image_url: width: 600
      endif
      if sph_logo == blank
        assign sph_logo = 'https://zapieers.com/cdn/shop/files/zapieers.png?v=1775205855&width=240'
      endif

      assign sph_cta_label = cta_label | default: 'Kupite sada'
      assign sph_cta_target = cta_target | default: 'shopping' | replace: '#', '' | strip
    -%}

    <section class="sph" id="sp-shopping-header" data-sp-header aria-label="Page header">
      <div class="sph__bar">
        <div class="sph__inner">
          <div class="sph__left">
            <a
              class="sph__logo sph__scroll"
              href="#{{ sph_cta_target }}"
              data-sph-target="{{ sph_cta_target }}"
              aria-label="{{ shop.name | escape }}"
            >
              <img src="{{ sph_logo }}" alt="{{ shop.name | escape }}" width="178" height="48" loading="eager" decoding="async">
            </a>
            <span class="sph__sep" aria-hidden="true"></span>
            <div class="sph__tagline stext2">
              <span>{{ sph_tagline }}</span>
              <img
                src="https://cdn.shopify.com/s/files/1/0991/9614/1880/files/hot.png?v=1776492941"
                alt=""
                width="28"
                height="28"
                loading="eager"
                decoding="async"
              >
            </div>
          </div>

          <div class="sph__right">
            <nav class="sph__nav" aria-label="Section navigation">
              {%- for text in sph_nav_text -%}
                {%- assign nav_label = text | strip -%}
                {%- assign nav_target = sph_nav_target[forloop.index0] | default: '' | replace: '#', '' | strip -%}
                {%- assign nav_icon_url = sph_nav_icon[forloop.index0] | default: '' | strip -%}
                {%- if nav_label != blank and nav_target != blank -%}
                  <a class="sph__nav-link sph__scroll " href="#{{ nav_target | escape }}" data-sph-target="{{ nav_target | escape }}">
                    {%- if nav_icon_url != blank -%}
                      <img src="{{ nav_icon_url }}" alt="" width="18" height="18" loading="lazy" decoding="async">
                    {%- endif -%}
                    <span>{{ nav_label | escape }}</span>
                  </a>
                  {%- unless forloop.last -%}
                    <span class="sph__nav-sep" aria-hidden="true"></span>
                  {%- endunless -%}
                {%- endif -%}
              {%- endfor -%}
            </nav>

            <button class="sph__cart js-cart" type="button" aria-label="Open shopping cart">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="21" viewBox="0 0 22 21" fill="none" aria-hidden="true">
