      <div id="shopping">
        <div class="sp_product_part">
          <div class="sp_product_content sp-product-layout">
            <div class="sp-relative sp-product-media">
              <div class="sp-gallery-main js-gallery-main">
                <div class="sp-product-visual js-product-visual">
                  {%- assign sp_first_product_image = product.images.first -%}
                  <div class="sp-product-gallery sp-product-gallery-pc sp_pc" aria-label="Product image" data-sp-pc-gallery>
                    {%- if sp_first_product_image -%}
                      {%- assign sp_first_product_image_url = sp_first_product_image | image_url: width: sp_first_product_image.width | split: '&width=' | first -%}
                      <img
                        alt="{{ sp_first_product_image.alt | default: product.title | escape }}"
                        class="sp-img-p js-img-p sp-pc-main-image js-pc-main-image"
                        src="{{ sp_first_product_image_url }}"
                        width="{{ sp_first_product_image.width }}"
                        height="{{ sp_first_product_image.height }}"
                        data-image-id="{{ sp_first_product_image.id }}"
                        data-image-position="0"
                        loading="eager"
                      >
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'sp-img-p js-img-p sp-pc-main-image js-pc-main-image sp-product-placeholder' }}
                    {%- endif -%}
                  </div>

                  <div class="sp-img-wrap sp-product-gallery sp-product-gallery-mobile sp_mobile swiper" aria-label="Product gallery" data-sp-product-gallery>
                    <div class="sp-img-inner swiper-wrapper">
                      {%- for image in product.images -%}
                        {%- assign sp_product_image_url = image | image_url: width: image.width | split: '&width=' | first -%}
                        <div
                          class="sp-product-slide js-product-slide swiper-slide{% if forloop.first %} is-active{% endif %}"
                          data-image-id="{{ image.id }}"
                          data-image-position="{{ forloop.index0 }}"
                        >
                          <img
                            alt="{{ image.alt | default: product.title | escape }}"
                            class="sp-img-p js-img-p"
                            src="{{ sp_product_image_url }}"
                            width="{{ image.width }}"
                            height="{{ image.height }}"
                            data-image-id="{{ image.id }}"
                            data-image-position="{{ forloop.index0 }}"
                            loading="eager"
                          >
                        </div>
                      {%- else -%}
                        <div class="sp-product-slide js-product-slide swiper-slide is-active">
                          {{ 'product-1' | placeholder_svg_tag: 'sp-img-p js-img-p sp-product-placeholder' }}
                        </div>
                      {%- endfor -%}
                    </div>
                    <button class="swiper-button-prev sp-gallery-prev js-gallery-prev" type="button" aria-label="Previous image"></button>
                    <button class="swiper-button-next sp-gallery-next js-gallery-next" type="button" aria-label="Next image"></button>
                  </div>

                  <div class="sp-img-clock js-img-clock sp_top_cut_down">
                    <div class="sp-stock-title stexts1">{{ sp_product_stock_text }}</div>
                    <div class="sp-stock-bottom">
                      <div class="sp-clock-s clock-wrap sp_left_view" aria-label="Offer countdown">
