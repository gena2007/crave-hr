      <div class="combine-box1">
        {% comment %} 四个卖点 {% endcomment %}
        <section class="sp-part1 features4">
          {% liquid
            assign features4_icons = cdn_img | append: 'sp1_1.webp|||'
            assign features4_icons = features4_icons | append: cdn_img | append: 'sp1_2.webp|||'
            assign features4_icons = features4_icons | append: cdn_img | append: 'sp1_3.webp|||'
            assign features4_icons = features4_icons | append: cdn_img | append: 'sp1_4.webp|||'
            assign features4_icons = features4_icons | split: '|||'
            assign features4_items = 'Potpora svodu stopala|||Ublažavanje udaraca|||Prostran prednji dio|||Protuklizni potplat' | split: '|||'
          %}
          <div class="features4__inner">
            <div class="features4__list">
              {%- for features4_item in features4_items -%}
                <div class="features4__item reveal-on-scroll">
                  <div class="features4__icon-wrap">
                    <img
                      class="features4__icon"
                      src="{{ features4_icons[forloop.index0] | strip }}"
                      alt="{{ features4_item | strip_html | escape }}"
                      width="76"
                      height="76"
                      loading="lazy"
                      decoding="async"
                    >
                  </div>
                  <p class="features4__text stexts2">{{ features4_item }}</p>
                </div>
              {%- endfor -%}
            </div>
          </div>
        </section>

        {% comment %} 四个痛点 {% endcomment %}
        <section class="sp-part2 pain-points4">
          {% liquid
            assign pain_points4_title = 'Obratite pozornost na ove skrivene probleme sa stopalima'
            assign pain_points4_subtitle = 'Dugotrajno nošenje neodgovarajuće obuće može pogoršati bol.'
            assign pain_points4_titles = 'Spušteni svodovi stopala|||Preopterećenje zglobova|||Pritisak na živce|||Nestabilan hod' | split: '|||'
            assign pain_points4_images = cdn_img | append: 'sp2_1.webp|||'
            assign pain_points4_images = pain_points4_images | append: cdn_img | append: 'sp2_2.webp|||'
            assign pain_points4_images = pain_points4_images | append: cdn_img | append: 'sp2_3.webp|||'
            assign pain_points4_images = pain_points4_images | append: cdn_img | append: 'sp2_4.webp|||'
            assign pain_points4_images = pain_points4_images | split: '|||'
          %}

          <div class="pain-points4__inner">
            {% comment %} 白色内容卡片：外层统一 16px 边距 {% endcomment %}
            <div class="pain-points4__panel">
              <h2 class="pain-points4__title reveal-on-scroll stitle2">{{ pain_points4_title }}</h2>
              <p class="ssubtitle reveal-on-scroll">{{pain_points4_subtitle}}</p>
              <div class="pain-points4__list swiper">
                <div class="swiper-wrapper">
                {% for item in pain_points4_titles %}
                  {% assign pain_points4_item = item | strip %}
                  <div class="pain-points4__item swiper-slide">
                    <div class="pain-points4__image-box reveal-on-scroll">
                      <img
                        class="pain-points4__image"
                        src="{{ pain_points4_images[forloop.index0] }}"
                        alt="{{ pain_points4_item | escape }}"
                        width="253"
                        height="143"
                        loading="lazy"
                        decoding="async"
                      >
                    </div>
