              </svg>
              <span class="sph__cart-count js-cardNum{% if cart.item_count < 1 %} sp-gray{% endif %} stext12">{{ cart.item_count }}</span>
            </button>

            <a class="sph__cta sph__scroll" href="#{{ sph_cta_target }}" data-sph-target="{{ sph_cta_target }}">
              {{ sph_cta_label }}
            </a>

            <button
              type="button"
              class="sph__menu-toggle js-header-menu-btn"
              aria-label="Open navigation menu"
              aria-expanded="false"
              aria-controls="sph-drawer"
            >
              <span aria-hidden="true"></span>
              <span aria-hidden="true"></span>
              <span aria-hidden="true"></span>
            </button>
          </div>
        </div>
      </div>

      <div class="sph__drawer-backdrop js-header-menu-btn" data-header-menu aria-hidden="true"></div>
      <aside class="sph__drawer" id="sph-drawer" data-header-menu aria-hidden="true">
        <div class="sph__drawer-head">
          <strong>Izbornik</strong>
          <button type="button" class="sph__drawer-close js-header-menu-btn" aria-label="Close navigation menu">×</button>
        </div>
        <nav class="sph__drawer-nav" aria-label="Mobile navigation">
          {%- for text in sph_nav_text -%}
            {%- assign nav_label = text | strip -%}
            {%- assign nav_target = sph_nav_target[forloop.index0] | default: '' | replace: '#', '' | strip -%}
            {%- assign nav_icon_url = sph_nav_icon[forloop.index0] | default: '' | strip -%}
            {%- if nav_label != blank and nav_target != blank -%}
              <a class="sph__drawer-link sph__scroll js-header-menu-btn" href="#{{ nav_target | escape }}" data-sph-target="{{ nav_target | escape }}">
                {%- if nav_icon_url != blank -%}
                  <img src="{{ nav_icon_url }}" alt="" width="20" height="20" loading="lazy" decoding="async">
                {%- endif -%}
                <span>{{ nav_label | escape }}</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
          <button class="sph__drawer-link js-cart js-header-menu-btn " type="button">
