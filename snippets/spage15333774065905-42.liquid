              <div class="sp-footer-wrap">
                <div class="sp-serive-box">
                  <section class="sp-service" aria-label="Service guarantees">
                    <div class="sp-service__grid">
                      {%- for item_title in sp_service_titles -%}
                        {%- assign card_title = item_title | strip -%}
                        {%- assign card_copy = sp_service_copies[forloop.index0] | default: '' | strip -%}
                        {%- assign card_icon = sp_service_icons[forloop.index0] | default: '' | strip -%}
                        {%- if card_title != blank or card_copy != blank or card_icon != blank -%}
                          <article class="sp-service__card">
                            {%- if card_icon != blank -%}
                              <span class="sp-service__icon" aria-hidden="true">
                                <img
                                  src="{{ card_icon }}"
                                  alt="{{ card_title | strip_html | escape }}"
                                  width="72"
                                  height="72"
                                  loading="lazy"
                                  decoding="async"
                                >
                              </span>
                            {%- endif -%}
                            {%- if card_title != blank -%}
                              <h3 class="sp-service__title stext20">{{ card_title }}</h3>
                            {%- endif -%}
                            {%- if card_copy != blank -%}
                              <p class="sp-service__copy stext2">{{ card_copy }}</p>
