                        <div class="sp-dots"><div class="sp-dot"></div><div class="sp-dot"></div></div>
                        <div class="square js-second stext20">00</div>
                      </div>
                      <div class="sp-countdown-promo stext2">
                        <strong>{{ sp_product_countdown_text }}</strong>
                        <div class="sp-countdown-progress" aria-hidden="true">
                          <span class="sp-countdown-progress__fill"></span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

