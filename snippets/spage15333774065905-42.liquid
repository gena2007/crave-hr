      {% comment %} faq {% endcomment %}
      {% liquid
        assign faq_id = 'faq'
        assign faq_title = 'Česta pitanja'
        assign faq_subtitle = 'Imate pitanja?<br>Ovdje ćete pronaći odgovore.'
        assign faq_contact_email = 'service@' | append: shop.name | append: '.com'
        assign faq_contact_labels = faq_contact_email | append: '|||+385 92 147 2589' | split: '|||'
        assign faq_contact_links = 'mailto:' | append: faq_contact_email | append: '|||tel:+385921472589' | split: '|||'
        assign faq_contact_icons = '📧|||📞' | split: '|||'
        assign faq_button_label = discount_btn
        assign faq_questions = "Koje vrste boli u stopalima ove cipele mogu ublažiti?|||Hoće li mi zbog mekanih potplata biti nestabilno dok stojim?|||Hoće li mi odgovarati ako imam visok rist ili široka stopala?|||Koliko su vodootporne i otporne na klizanje?|||Mogu li ih nositi i ako nemam tegoba sa stopalima?" | split: '|||'
        assign faq_answers = "Sveobuhvatno olakšanje. Prostran prednji dio smanjuje pritisak na čukljeve, potpora svodu stopala ublažava tegobe plantarne fascije, a amortizacija cijelom dužinom smanjuje opterećenje koljena i gležnjeva.|||Ne. Amortizacija u prednjem dijelu ublažava udarce, a ojačana peta pruža stabilnost. Dvostruki bočni sustav stabilizacije učinkovito sprječava izvrtanje gležnja.|||Da. Unutrašnjost je šira i dublja te pruža dovoljno prostora i stopalima s čukljevima ili oteklinama, bez pritiska na živce.|||Ugrađeni vodootporni i prozračni sloj štiti od kiše, a gumeni potplat s dubokim profilom pruža odlično prianjanje. Možete sigurno hodati čak i po mokrim pločicama ili ulicama po kiši.|||Da. Ergonomska amortizacija i potpora svodu stopala pružaju preventivnu zaštitu različitim oblicima stopala te su prikladne za svakodnevno hodanje." | split: '|||'
        assign faq_open_index = 1
      %}
      <section class="faq" id="{{ faq_id }}">
        <div class="faq__inner">
          <div class="faq__layout">
            <div class="faq__intro reveal-on-scroll">
              <h2 class="faq__title stitle2">{{ faq_title }}</h2>
              <p class="faq__subtitle ssubtitle">{{ faq_subtitle }}</p>

              <div class="faq__contacts">
                {% for faq_contact_label in faq_contact_labels %}
                  {% assign faq_contact_index = forloop.index0 %}
                  <a class="faq__contact stext2" href="{{ faq_contact_links[faq_contact_index] }}">
                    <span class="faq__contact-icon" aria-hidden="true">{{ faq_contact_icons[faq_contact_index] }}</span>
                    <span>{{ faq_contact_label }}</span>
                  </a>
                {% endfor %}
              </div>

              <div class="faq__button-wrap faq__button--desktop">
                <a class="common-button" href="#shopping">
                  {{- faq_button_label -}}
                  <span class="btn-arrow" aria-hidden="true">
                    <svg viewBox="0 0 18 28" width="10" height="16" fill="none">
                      <path d="M3 3l11 11L3 25" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg></span
                ></a>
              </div>
            </div>

            <div class="faq__content reveal-on-scroll">
              <div class="faq__list" id="{{ faq_id }}-list">
                {% for faq_question in faq_questions %}
                  {% assign faq_index = forloop.index0 %}
                  {% assign faq_answer = faq_answers[faq_index] %}
                  {% assign faq_is_open = false %}
                  {% if forloop.index == faq_open_index %}
                    {% assign faq_is_open = true %}
                  {% endif %}

                  <article class="faq__item{% if faq_is_open %} is-open{% endif %}">
                    <button
                      class="faq__question"
                      type="button"
                      aria-expanded="{% if faq_is_open %}true{% else %}false{% endif %}"
                      aria-controls="{{ faq_id }}-answer-{{ forloop.index }}"
                    >
                      <span class="faq__question-text stexts2">{{ faq_question }}</span>
                      <span class="faq__question-icon" aria-hidden="true">
                        <span class="faq__plus">+</span>
                        <span class="faq__minus">−</span>
                      </span>
                    </button>

                    <div class="faq__answer" id="{{ faq_id }}-answer-{{ forloop.index }}">
                      <div class="faq__answer-inner stext2">{{ faq_answer }}</div>
                    </div>
                  </article>
                {% endfor %}
              </div>

              <div class="faq__button-wrap faq__button--mobile">
                <a class="common-button" href="#shopping">
                  {{- faq_button_label -}}
                  <span class="btn-arrow" aria-hidden="true">
                    <svg viewBox="0 0 18 28" width="10" height="16" fill="none">
                      <path d="M3 3l11 11L3 25" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg></span
                ></a>
              </div>
            </div>
          </div>
        </div>
      </section>

      {% comment %} 尺寸弹窗 {% endcomment %}
      <div class="sp-size-modal" data-sp-size-modal aria-hidden="true">
        <div class="sp-size-modal__overlay" data-sp-size-close></div>
        <div class="sp-size-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="sp-size-modal-title">
          <button class="sp-size-modal__close" type="button" data-sp-size-close aria-label="Close size guide">×</button>
          
          <div class="sp-size-modal__table-wrap">
            <section class="pssg pssg--{{ section.id }}" aria-label="Size chart">
              <div class="pssg__inner">
                <h2 class="pssg__title">{{ size_chart_title }}</h2>

                <div class="pssg__content">
                  <div class="pssg__left">
                    <div class="pssg__table-wrap">
                      <table class="pssg__table">
                        <thead>
                          <tr>
                            <th>{{ size_chart_eu_label }}</th>
                            <th>
                              <span class="pssg__pc-label">{{ size_chart_length_label }}</span>
                             
                              <span>{{ size_chart_unit_label }}</span>
                            </th>
                            <th>{{ size_chart_eu_label }}</th>
                            <th>
                              <span class="pssg__pc-label">{{ size_chart_length_label }}</span>
                             
                              <span>{{ size_chart_unit_label }}</span>
                            </th>
                          </tr>
                        </thead>
                        <tbody>
                          {%- for row in size_chart_rows -%}
                            {%- assign cols = row | split: '|' -%}
                            <tr>
                              <td>{{ cols[0] }}</td><td>{{ cols[1] }}</td><td>{{ cols[2] }}</td><td>{{ cols[3] }}</td>
                            </tr>
                          {%- endfor -%}
                        </tbody>
                      </table>
                    </div>

                    <div class="pssg__notice pssg__notice--pc">
                      <img class="pssg__notice-icon" src="{{ size_chart_notice_icon }}" alt="{{ size_chart_notice_icon_alt | escape }}" width="52" height="52" loading="lazy" decoding="async">
                      <div class="pssg__notice-text">
                        <strong>{{ size_chart_notice_title }}</strong>
                        <p>{{ size_chart_notice_description }}</p>
                      </div>
                    </div>
                  </div>

                  <div class="pssg__right">
                    <img class="pssg__foot-image" src="{{ size_chart_measure_image }}" alt="{{ size_chart_measure_image_alt | escape }}" width="350" height="225" loading="lazy" decoding="async">

                    <ul class="pssg__tips">
                      {%- for tip in size_chart_tips -%}
                        <li>{{ tip | strip }}</li>
                      {%- endfor -%}
                    </ul>

                    <div class="pssg__notice pssg__notice--mobile">
                      <img class="pssg__notice-icon" src="{{ size_chart_notice_icon }}" alt="{{ size_chart_notice_icon_alt | escape }}" width="54" height="54" loading="lazy" decoding="async">
                      <div class="pssg__notice-text">
                        <strong>{{ size_chart_notice_title }}</strong>
                        <p>{{ size_chart_notice_description }}</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </section>
          </div>
        </div>
      </div>

      {% comment %} 购物车底部加购模块 {% endcomment %}
      <div class="sp-shopping-drawer">
        
        {%- assign sp_cart_drawer_label = sp_cart_drawer_label | default: 'Shopping cart' -%}
        {%- assign sp_cart_drawer_close_label = sp_cart_drawer_close_label | default: 'Close shopping cart' -%}
        {%- assign sp_cart_drawer_notice = sp_cart_drawer_notice | default: '✓ Sigurna naplata · Brza dostava · Jednostavan povrat' -%}
        {%- assign sp_cart_drawer_loading = sp_cart_drawer_loading | default: 'Učitavanje košarice…' -%}
        {%- assign sp_cart_drawer_empty_icon = sp_cart_drawer_empty_icon | default: '🛒' -%}
        {%- assign sp_cart_drawer_empty_text = sp_cart_drawer_empty_text | default: 'Vaša je košarica trenutačno prazna.' -%}
        {%- assign sp_cart_drawer_continue = sp_cart_drawer_continue | default: 'Nastavite kupovati' -%}
        {%- assign sp_cart_drawer_note_toggle = sp_cart_drawer_note_toggle | default: 'Dodaj napomenu uz narudžbu' -%}
        {%- assign sp_cart_drawer_note_placeholder = sp_cart_drawer_note_placeholder | default: 'Add delivery instructions or a note for your order' -%}
        {%- assign sp_cart_drawer_note_save = sp_cart_drawer_note_save | default: 'Spremi napomenu' -%}
        {%- assign sp_cart_drawer_subtotal = sp_cart_drawer_subtotal | default: 'Međuzbroj' -%}
        {%- assign sp_cart_drawer_tax_note = sp_cart_drawer_tax_note | default: 'Porezi i dostava obračunavaju se pri naplati.' -%}
        {%- assign sp_cart_drawer_checkout = sp_cart_drawer_checkout | default: 'Sigurna naplata' -%}

        <div class="sp-cart-drawer-overlay" data-sp-drawer-overlay aria-hidden="true"></div>

        <aside class="sp-cart-drawer" data-sp-cart-drawer aria-hidden="true" aria-label="{{ sp_cart_drawer_label }}">
          <div class="sp-cart-drawer__header">
            <h2 class="sp-cart-drawer__heading stexts1">{{ sp_cart_drawer_label }} (<span class="js-cardNum">0</span>)</h2>
            <button class="sp-cart-drawer__close" type="button" data-sp-drawer-close aria-label="{{ sp_cart_drawer_close_label }}">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </button>
          </div> 

          <div class="sp-cart-drawer__notice stext14">{{ sp_cart_drawer_notice }}</div>

          <div class="sp-cart-drawer__body">
            <div class="sp-cart-drawer__loading" data-sp-cart-loading>{{ sp_cart_drawer_loading }}</div>

            <div class="sp-cart-drawer__empty" data-sp-cart-empty>
              <div class="sp-cart-drawer__empty-icon">{{ sp_cart_drawer_empty_icon }}</div>
              <p class="stext2">{{ sp_cart_drawer_empty_text }}</p>
              <button class="sp-cart-drawer__continue" type="button" data-sp-drawer-close>{{ sp_cart_drawer_continue }}</button>
            </div>

            <div class="sp-cart-drawer__items" data-sp-cart-items aria-live="polite"></div>
          </div>

          <div class="sp-cart-drawer__footer" data-sp-cart-footer hidden>
            <div class="sp-cart-drawer__note js-cart-drawer__note">
              <button class="sp-cart-drawer__note-toggle stext16" type="button" aria-expanded="false" aria-controls="sp-cart-note-panel" data-sp-cart-note-toggle>
                <span data-sp-cart-note-toggle-label>{{ sp_cart_drawer_note_toggle }}</span>
                <span class="sp-cart-drawer__note-chevron" aria-hidden="true">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M10 6l-1.41 1.41L13.17 12l-4.58 4.59L10 18l6-6z" fill="#000"></path>
                    </svg>
                </span>
              </button>
              <div class="sp-cart-drawer__note-panel" id="sp-cart-note-panel" data-sp-cart-note-panel hidden>
                {% comment %} <label class="sp-cart-drawer__note-label stext14" for="sp-cart-note">Order note</label> {% endcomment %}
                <textarea class="sp-cart-drawer__note-input" id="sp-cart-note" maxlength="500" placeholder="{{ sp_cart_drawer_note_placeholder }}" data-sp-cart-note></textarea>
                <div class="sp-cart-drawer__note-actions">
                  <span class="sp-cart-drawer__note-status stext12" data-sp-cart-note-status aria-live="polite"></span>
                  <button class="sp-cart-drawer__note-save stext12" type="button" data-sp-cart-note-save>{{ sp_cart_drawer_note_save }}</button>
                </div>
              </div>
            </div>
            <div class="sp-cart-drawer__subtotal stexts2">
              <span>{{ sp_cart_drawer_subtotal }}</span>
              <span class="sp-cart-drawer__subtotal-value stext20" data-sp-cart-total></span>
            </div>
            <p class="sp-cart-drawer__tax-note stext14">{{ sp_cart_drawer_tax_note }}</p>
            <a class="sp-cart-drawer__checkout js-cart-drawer__checkout common-button" href="/checkout">{{ sp_cart_drawer_checkout }}</a>
          </div>
        </aside>

      </div>
      <!-- 页面底部加购模块 -->
      <div class="sp-fixed-purchase-mount">
        
        {%  assign buy = buy_now_btn | default: 'BUY NOW' %}
        <section class="sp-fixed-purchase" data-sp-fixed-purchase aria-label="Quick purchase">
          <div class="sp-fixed-purchase__inner">
            <div class="sp-fixed-purchase__product">
              {%- assign sp_fixed_product_image = product.selected_or_first_available_variant.featured_image | default: product.featured_image -%}
              {%- if sp_fixed_product_image -%}
                {%- assign sp_fixed_product_image_url = sp_fixed_product_image | image_url: width: sp_fixed_product_image.width | split: '&width=' | first -%}
              {%- else -%}
                {%- assign sp_fixed_product_image_url = '' -%}
              {%- endif -%}
              <img
                class="sp-fixed-purchase__image js-bind-image"
                src="{{ sp_fixed_product_image_url }}"
                alt="{{ product.title | escape }}"
                width="80"
                height="80"
              >
              <div class="sp-fixed-purchase__meta">
                <p class="sp-fixed-purchase__title js-bind-title stext16">{{ product.title }}</p>
                <div class="sp-fixed-purchase__prices">
                  <span class="sp-fixed-purchase__price js-bind-price stext20"></span>
                  <span class="sp-fixed-purchase__compare js-bind-compare stext14"></span>
                </div>
              </div>
            </div>

            {%- unless product.has_only_default_variant -%}
              <div class="sp-fixed-purchase__options">
                {%- for option in product.options_with_values -%}
                  <select
                    class="sp-fixed-purchase__select js-variant-select stext16"
                    data-option-index="{{ forloop.index0 }}"
                    aria-label="{{ option.name | escape }}"
                  >
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>
                        {{ value | escape }}
                      </option>
                    {%- endfor -%}
                  </select>
                {%- endfor -%}
              </div>
            {%- endunless -%}

            <div class="sp-fixed-purchase__actions">
              <div class="sp-fixed-purchase__qty" aria-label="Quantity">
                <button class="js-reduce" type="button" aria-label="Decrease quantity">−</button>
                <input class="js-calcNumber stext2" type="number" min="1" max="200" value="1" inputmode="numeric" aria-label="Quantity">
                <button class="js-add" type="button" aria-label="Increase quantity">+</button>
              </div>

              <button class="sp-fixed-purchase__cart js-fixed-purchase__cart js-add-cart" type="button" aria-label="Add to cart">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M3 4h2l2.2 10.1a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 1.9-1.4L21 7H6M10 20a1 1 0 1 1-2 0 1 1 0 0 1 2 0Zm9 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="js-cardNum">0</span>
              </button>

              <button class="sp-fixed-purchase__buy js-buy-now common-button" type="button">{{ buy }}</button>
            </div>
          </div>
        </section>
      </div>
    </div>

    {% comment %} 产品需要的数据 {% endcomment %}
    <script>
      window.product = {{ product.variants | json }};
      window.options = {{ product.options_with_values | json }};
      window.shopMoneyFormat = {{ shop.money_format | json }};
      window.spCurrencyCode = {{ cart.currency.iso_code | default: localization.country.currency.iso_code | json }};
      window.spLocale = {{ request.locale.iso_code | json }};
      window.cartCount = {{ cart.item_count | json }};
      window.spSelectedVariantId = {{ product.selected_or_first_available_variant.id | json }};
      window.spProductTitle = {{ product.title | json }};
    </script>

    <script src="{{ 'jquery.min.js' | asset_url }}" defer></script>
    <script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
    <script src="https://cdn.shopify.com/s/files/1/0807/0086/6801/files/spage-YH108359-42-HR.js?v=1795421642" defer></script>
  </body>
</html>
