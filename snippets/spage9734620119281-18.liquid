                        {{ option.name | escape }}:
                        {%- if forloop.first -%}
                          <span class="js-option-current" data-sp-option-current="{{ forloop.index0 }}">
                            {{- option.selected_value | default: option.values.first | escape -}}
                          </span>
                        {%- endif -%}
                      </div>
                      {%- if forloop.index == 2 -%}
                        <button class="js-size-guide" type="button" aria-label="Size Chart">
