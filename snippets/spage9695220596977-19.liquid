                      {%- for value in option.values -%}
                        {%- liquid
                          assign is_active = false
                          if option.selected_value == value
                            assign is_active = true
                          elsif option.selected_value == blank and forloop.first
                            assign is_active = true
                          endif
                        -%}
                        <button
                          type="button"
                          class="js-option{% if is_active %} active{% endif %}{% if option.position == 1 %} js-option-swatch{% endif %}"
                          data-val="{{ value | escape }}"
                          data-option-position="{{ option.position }}"
                        >
                          {%- if option.position == 1 -%}
                            {%- assign option_variant = product.variants | where: 'option1', value | first -%}
                            {%- if option_variant.featured_image -%}
                              <img
                                src="{{ option_variant.featured_image | image_url: width: 160 }}"
                                alt="{{ value | escape }}"
                              >
