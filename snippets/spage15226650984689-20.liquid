<!doctype html>
<html lang="hr">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ product.title }}</title>
  </head>
  <body>
    {{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
    <link rel="stylesheet" href="https://cdn.shopify.com/s/files/1/0807/0086/6801/files/ID-20-YH107740-HR_3.css?v=1792045383">

    <style>
      /* 克罗地亚专属样式 */
      @media (max-width: 767px) {
        .ems-hero__delivery,
        .ems-hero__delivery span { font-size: 9px; }
        .ems-hero__stock-status strong { font-size: 9px; }
        .ems-hero__delivery .ems-hero__stock-quantity { font-size: 9px; }
        .ems-therapy__stock > span:first-child,
        .ems-therapy__stock [data-sp-delivery-start],
        .ems-therapy__stock strong { font-size: 12px; }
        .ems-results__stock > span:first-child,
        .ems-results__stock [data-sp-delivery-start],
        .ems-results__stock > span:nth-child(3),
        .ems-results__stock-low { font-size: 12px; }
        .ems-shoe-function__stock > span,
        .ems-shoe-function__stock [data-sp-delivery-start] { font-size: 12px; }
        .ems-doctor__promo { font-size: 15px; }
        .ems-doctor__promo strong,
        .ems-doctor__promo strong span,
        .ems-doctor__promo-condition { font-size: 15px; }
        .ems-size__promo { font-size: 15px; }
        .ems-size__promo strong,
        .ems-size__promo strong span,
        .ems-size__promo-condition { font-size: 15px; }
        #root .ems-shopping .sp-delivery-note,
        #root .ems-shopping .sp-tax-note { font-size: 12px; }
      }
    </style>

    {% comment %} 落地页内容 {% endcomment %}
    <div
      id="root"
      data-page-id="ID-20-YH107740-G122"
      style="
        --wrapper-mw:1232px;
        --primary-color:#24aa2f;
        --secondary-color: #EFF7FF;
        --third-color: #FF0000;
        --btn-color:#fff;
        --btn-bg-color:#24aa2f;
      "
    >

      {% comment %} 公告栏 {% endcomment %}
      {%- capture sp_announcement_content -%}
        <p class="announcement-bar-w__text">
          <span class="announcement-bar-w__intro">Program podrške rehabilitaciji s ograničenim trajanjem:</span>
          <strong class="announcement-bar-w__offer">Uštedite do <span class="js-bind-discount-percent">60%</span> danas · 30-dnevni probni period bez rizika</strong>
        </p>
      {%- endcapture -%}
      <div class="announcement-bar-w common-pc--hide">
        {{ sp_announcement_content }}
      </div>

      {% comment %} 头部 {% endcomment %}
        <div class="announcement-bar-w common-mb--hide">
          {{ sp_announcement_content }}
        </div>
      <section class="sph" id="sp-shopping-header" data-sp-header aria-label="Zaglavlje stranice">
        {%- liquid
          assign sph_logo = logo | default: '' | strip
          if sph_logo == blank and settings.logo != blank
            assign sph_logo = settings.logo | image_url: width: 600
          endif
          if sph_logo == blank
            assign sph_logo = 'https://cdn.shopify.com/s/files/1/0688/0460/8043/files/6888a41632338a4443544e81_EMSense_20logo.svg?v=1791771380'
          endif
        -%}
        <div class="sph__bar">
          <div class="sph__inner ">
            <div class="sph__left">
              <a
                class="sph__logo sph__scroll"
                href="{{ routes.root_url }}"
                aria-label="{{ shop.name | escape }}"
              >
                <img
                  src="{{ sph_logo }}"
                  alt="{{ shop.name | escape }}"
                  width="178"
                  height="48"
                  loading="eager"
                  decoding="async"
                >
              </a>
              <span class="sph__sep" aria-hidden="true"></span>
              <span class="sph__tagline">Gotovina pri dostavi</span>
            </div>

            <div class="sph__right">
              <nav class="sph__nav" aria-label="Navigacija dionicama">
                <button class="sph__nav-link js-size-guide" type="button">
                  <img class="sph__nav-icon" src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_size-chart.svg?v=1791863371" alt="" width="24" height="24">
                  <span>Tablica veličina</span>
                </button>
                <a class="sph__nav-link sph__scroll" href="#bewertungen" data-sph-target="bewertungen">
                  <img class="sph__nav-icon" src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_reviews.svg?v=1791863371" alt="" width="24" height="24">
                  <span>Recenzije</span>
                </a>
               
                <a class="sph__nav-link sph__scroll" href="#faq" data-sph-target="faq">
                  <img class="sph__nav-icon" src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_faq.svg?v=1791863371" alt="" width="24" height="24">
                  <span>Često postavljana pitanja</span>
                </a>
              </nav>

              <button class="sph__cart js-cart" type="button" aria-label="Otvorena kolica za kupovinu">
                <svg class="sph__cart-icon sph__cart-icon--pc" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16l1 13H3L4 7Zm4 0V5a4 4 0 0 1 8 0v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <img class="sph__cart-icon sph__cart-icon--mb" src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_cart.svg?v=1791863579" alt="" width="28" height="28">
                <span class="text">KOŠARICA</span>
                <span class="sph__cart-count js-cardNum{% if cart.item_count < 1 %} sp-gray{% endif %}">
                  {{- cart.item_count -}}
                </span>
              </button>

              <a class="sph__cta sph__scroll" href="#shopping" data-sph-target="shopping">
                <span>KUPITE ODMAH</span>
              </a>

              <button
                type="button"
                class="sph__menu-toggle js-header-menu-btn"
                aria-label="Otvorite izbornik za navigaciju"
                aria-expanded="false"
                aria-controls="sph-drawer"
              >
                <img class="sph__menu-icon" src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_menu.svg?v=1791863579" alt="" width="27" height="24">
              </button>
            </div>
          </div>
        </div>

        <div class="sph__drawer-backdrop js-header-menu-btn" data-header-menu aria-hidden="true"></div>
        <aside class="sph__drawer" id="sph-drawer" data-header-menu aria-hidden="true" inert role="dialog" aria-modal="true" aria-labelledby="sph-drawer-title">
          <div class="sph__drawer-head">
            <strong id="sph-drawer-title">Jelovnik</strong>
            <button type="button" class="sph__drawer-close js-header-menu-btn" aria-label="Zatvori izbornik za navigaciju">
              ×
            </button>
          </div>
          <nav class="sph__drawer-nav" aria-label="Mobilna navigacija">
            <button class="sph__drawer-link js-size-guide" type="button" data-sp-header-menu-close>
              <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_size-chart.svg?v=1791863371" alt="" width="20" height="20">
              <span>Tablica veličina</span>
            </button>
            <a class="sph__drawer-link sph__scroll" href="#bewertungen" data-sph-target="bewertungen" data-sp-header-menu-close>
              <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_reviews.svg?v=1791863371" alt="" width="20" height="20">
              <span>Recenzije</span>
            </a>
            <a class="sph__drawer-link sph__scroll" href="#faq" data-sph-target="faq" data-sp-header-menu-close>
              <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_faq.svg?v=1791863371" alt="" width="20" height="20">
              <span>Često postavljana pitanja</span>
            </a>
            <button class="sph__drawer-link js-cart" type="button" data-sp-header-menu-close>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16l1 13H3L4 7Zm4 0V5a4 4 0 0 1 8 0v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span
                >Košarica (<span class="js-cardNum">{{ cart.item_count }}</span>)</span
              >
            </button>
            <a class="sph__drawer-link sph__drawer-buy sph__scroll" href="#shopping" data-sph-target="shopping" data-sp-header-menu-close>KUPITE ODMAH</a>
          </nav>
        </aside>
      </section>

      {% comment %} 首屏介绍 {% endcomment %}
      <section class="ems-hero" id="produkt">
        <div class="ems-shell ems-hero__inner">
          <div class="ems-hero__media reveal-on-scroll">
            <div class="ems-hero__animation" data-sp-hero-media>
              <picture class="ems-hero__poster">
                <source media="(max-width: 767px)" srcset="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_banner-gif_poster_mb.webp?v=1791873931">
                <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_banner-gif_poster.webp?v=1791873931" alt="Ortopedske cipele za hodanje na patentni zatvarač" width="562" height="746" loading="eager" fetchpriority="high">
              </picture>
              <img class="ems-hero__animated-image" data-sp-hero-animation src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_banner-gif.webp?v=1791873881" alt="Demonstracija ortopedskih cipela za hodanje na patentni zatvarač" width="562" height="746" loading="eager" decoding="async">
            </div>
          </div>
          <div class="ems-hero__copy">
            <div class="ems-hero__expert">
              <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_banner_doctor.webp?v=1791874143" alt="" width="32" height="32" loading="eager">
              <span>Preporučeno od strane <strong>stručnjaka za njegu stopala</strong></span>
            </div>
            <div class="ems-hero__rating">
              <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_banner_rating.svg?v=1791874211" alt="Ocjena Trustpilota: 4,7 od 5" width="224" height="22" loading="eager">
            </div>
            <h1 class="ems-hero__title">Nova nada! Ortopedska udobnost za bolne pete i zglobove</h1>
            <div class="ems-hero__lead">
              <p>Ako stojite više od <strong>4 sata</strong> dnevno ili često osjećate bol u peti ili koljenu, molimo vas da odvojite 2 minute za čitanje ovog članka.</p>
              <p>Inovativna <strong>tehnologija apsorpcije udaraca</strong>, osmišljena za ispravljanje hoda i smanjenje pritiska na zglobove, osvaja Europu i mijenja način na koji tisuće ljudi hodaju...</p>
            </div>
            <ul class="ems-check-list">
              <li><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_banner_wide-toe.webp?v=1791874143" alt="" width="37" height="29"><span><strong>Široka kutija za prste</strong> pomaže ublažiti oticanje, pritisak čukljeva i osjetljivost.</span></li>
              <li><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_banner_flexible-sole.webp?v=1791874143" alt="" width="37" height="29"><span><strong>Fleksibilni taban</strong> pomaže ublažiti udarce na stopala, koljena i zglobove.</span></li>
              <li><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_banner_arch-support.webp?v=1791874144" alt="" width="37" height="29"><span><strong>Potpora svoda</strong> potiče bolju ravnotežu i stabilniji korak.</span></li>
            </ul>
            <a class="common-button ems-cta ems-hero__cta" href="#shopping">
              <span class="ems-hero__cta-label">NARUČITE SADA I OSTVARITE DO <span class="js-bind-discount-percent">60%</span> POPUSTA</span>
              <img class="ems-hero__cta-arrow" src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_arrow-icon1.svg?v=1791874256" alt="" width="42" height="42">
            </a>
            <div class="ems-hero__stock">
              <span class="ems-hero__stock-label"><img class="ems-hero__stock-clock" src="https://cdn.shopify.com/s/files/1/0990/0215/5371/files/icons8-_-96.apng?v=1783565616" alt="" width="24" height="24" loading="eager"><span>Trenutna razina zaliha: <strong class="ems-hero__stock-quantity">Ostalo je samo 6!</strong></span></span>
              <span class="ems-hero__delivery">Otpremamo do <span data-sp-delivery-start></span> <span class="ems-hero__delivery-separator" aria-hidden="true">|</span> <strong class="ems-hero__stock-quantity">Ostalo je samo 6!</strong></span>
              <span class="ems-hero__stock-status"><span class="ems-hero__stock-meter" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span><strong>NISKA</strong></span>
            </div>
            <p class="ems-hero__secure">🔒 Zajamčeno sigurno i zaštićeno plaćanje | SSL zaštićen 🔒</p>
          </div>
        </div>

        <div class="ems-shell ems-benefits reveal-on-scroll">
          <article class="ems-benefit">
            <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_banner_30-day.webp?v=1791874468" alt="" width="96" height="96" loading="lazy">
            <div><h3>30-dnevni povrat novca</h3><p>Sigurni smo da će vam se svidjeti—isprobajte ga bez rizika 30 dana ili zatražite puni povrat novca.</p></div>
          </article>
          <article class="ems-benefit">
            <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_banner_tracked-worldwide.webp?v=1791874468" alt="" width="96" height="96" loading="lazy">
            <div><h3>Praćeni svjetski prijevoz</h3><p>Svaka narudžba uključuje praćenje u stvarnom vremenu i osiguranje od gubitka ili krađe tijekom transporta.</p></div>
          </article>
          <article class="ems-benefit">
            <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_banner_powered-real.webp?v=1791874468" alt="" width="96" height="96" loading="lazy">
            <div><h3>Pokretani stvarnim korisnicima</h3><p>Iskustvo stvarnog korisnika pokreće naš razvoj i testiranje kako bismo stvorili ultimativno rješenje.</p></div>
          </article>
        </div>
      </section>

      {% comment %} 四项步行鞋优势 {% endcomment %}
      <section class="ems-step-benefits" aria-labelledby="ems-step-benefits-title">
        <div class="ems-step-benefits__inner">
          <h2 class="ems-step-benefits__title reveal-on-scroll" id="ems-step-benefits-title">Tajna je ugrađena u svaki pojedini korak:</h2>
          <div class="ems-step-benefits__grid">
            <article class="ems-step-benefits__card reveal-on-scroll">
              <img class="ems-step-benefits__image" src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_sp1_1.webp?v=1791877653" alt="Muškarac u zelenim ortopedskim cipelama za hodanje" width="290" height="356" loading="lazy" decoding="async">
              <div class="ems-step-benefits__body">
                <h3 class="ems-step-benefits__heading"><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_correct.svg?v=1791877732" alt="" width="20" height="20" loading="lazy"><span>Ispravlja ravna stopala</span></h3>
                <p class="ems-step-benefits__description">Anatomska potpora svodu ispravlja ravna stopala obnavljanjem spuštenih svodova i prirodnog položaja stopala.</p>
              </div>
            </article>
            <article class="ems-step-benefits__card reveal-on-scroll">
              <img class="ems-step-benefits__image" src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_sp1_2.webp?v=1791877653" alt="Muškarac u cipelama za hodanje u vinogradu" width="290" height="356" loading="lazy" decoding="async">
              <div class="ems-step-benefits__body">
                <h3 class="ems-step-benefits__heading"><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_correct.svg?v=1791877732" alt="" width="20" height="20" loading="lazy"><span>Liječi bol u svodu stopala</span></h3>
                <p class="ems-step-benefits__description">Čvrsta potpora ispod stopala liječi bol u svodu stopala i potpuno uklanja opterećenje na oslabljena plantarna tkiva.</p>
              </div>
            </article>
            <article class="ems-step-benefits__card reveal-on-scroll">
              <img class="ems-step-benefits__image" src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_sp1_3.webp?v=1791877653" alt="Sjedeća osoba u crnim ortopedskim cipelama za hodanje" width="290" height="356" loading="lazy" decoding="async">
              <div class="ems-step-benefits__body">
                <h3 class="ems-step-benefits__heading"><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_correct.svg?v=1791877732" alt="" width="20" height="20" loading="lazy"><span>Poravnava gležnjeve</span></h3>
                <p class="ems-step-benefits__description">Stabilizirajuća peta poravnava gležnjeve, ispravlja uvijanje prema unutra i prirodno poboljšava držanje donjeg dijela tijela.</p>
              </div>
            </article>
            <article class="ems-step-benefits__card reveal-on-scroll">
              <img class="ems-step-benefits__image" src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_sp1_4.webp?v=1791877653" alt="Muškarac u svijetlim tenisicama za hodanje na ulici" width="290" height="356" loading="lazy" decoding="async">
              <div class="ems-step-benefits__body">
                <h3 class="ems-step-benefits__heading"><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_correct.svg?v=1791877732" alt="" width="20" height="20" loading="lazy"><span>Oslobađa bol u koljenu</span></h3>
                <p class="ems-step-benefits__description">Ispravan položaj stopala ublažava bol u koljenima smanjenjem štetnog pritiska na zglobove koji nose težinu tijekom hodanja.</p>
              </div>
            </article>
          </div>
        </div>
      </section>

      {% comment %} Fußschmerzen Ursache {% endcomment %}
      <section class="ems-cause" id="ergebnisse">
        <div class="ems-shell">
          <div class="ems-split ems-split--media-left">
            <video class="ems-media reveal-on-scroll" data-sp-cause-video poster="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_sp2_video_poster.webp?v=1791880690" data-poster-pc="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_sp2_video_poster.webp?v=1791880690" data-poster-mb="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_sp2_video_poster_mb.webp?v=1791880689" width="599" height="579" autoplay muted loop playsinline preload="metadata">
              <source src="https://cdn.shopify.com/videos/c/o/v/4977123241dc41af9ff5c9545fdea611.mp4" type="video/mp4">
            </video>
            <div class="ems-rich-text stext2">
              <h2 class="ems-cause__title stitle2 reveal-on-scroll">Zašto su obične cipele toliko neugodne?</h2>
              <p>Većina cipela dizajnirana je za stil – <strong>a ne za zdravlje stopala.</strong></p>
              <p>Tvrdi potplati nemaju amortizaciju, <strong>šalju veći udar kroz vaša stopala</strong> pri svakom koraku. Uske kutije za prste stišću prste i <strong>pritiskaju izravno na čukljeve.</strong></p>
              <p>Slaba potpora svoda omogućuje nakupljanje napetosti, <strong>često uzrokujući bol nakon samo 2–3 sata.</strong> Loši materijali zadržavaju toplinu i znoj, ostavljajući stopala vlažnima.</p>
              <p><strong>Tvrdi materijali. Jeftini potplati. Mala potpora.</strong></p>
              <p>Ove dizajnerske pogreške mogu biti pravi razlog zašto vas stopala bole.</p>
              <p>Ali ne brinite…</p>
              <a class="ems-solution stexts2" href="#shopping">
                <span>PRONAŠLI SMO PAMETNIJI NAČIN NAPRIJED!</span>
                <span class="ems-solution__arrow" aria-hidden="true"></span>
              </a>
            </div>
          </div>
          <div class="ems-stat-grid reveal-on-scroll">
            <article class="ems-stat-card" data-sp-stat-wrap>
              <div class="ems-stat-ring">
                <svg viewBox="0 0 120 120" aria-hidden="true">
                  <circle class="ems-stat-ring__track" cx="60" cy="60" r="52"></circle>
                  <circle class="ems-stat-ring__progress js-stat-progress" cx="60" cy="60" r="52" data-sp-stat-radius="52"></circle>
                </svg>
                <strong class="ems-stat-ring__value stitle2"><span class="js-stat-num" data-sp-stat-value="89">0</span><span class="ems-stat-percent">%</span></strong>
              </div>
              <p class="stexts2">od odraslih ispitanika kaže da bol u čukljevima postaje gora u uskim cipelama.</p>
            </article>
            <article class="ems-stat-card" data-sp-stat-wrap>
              <div class="ems-stat-ring">
                <svg viewBox="0 0 120 120" aria-hidden="true">
                  <circle class="ems-stat-ring__track" cx="60" cy="60" r="52"></circle>
