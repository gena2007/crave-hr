<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ product.title }}</title>
  </head>
  <body>
    {{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
    <link rel="stylesheet"  href="https://cdn.shopify.com/s/files/1/0807/0086/6801/files/ID-27-YH105725-HR.css?v=1792658714" >
    

    {% comment %} 落地页内容 {% endcomment %}
    <div
      id="root"
      data-page-id="27"
      style="
        --wrapper-mw:1232px;
        --primary-color:#24aa2f;
        --secondary-color: #EFF7FF;
        --third-color: #FF0000;
        --btn-color:#fff;
        --btn-bg-color:#24aa2f;
      "
    >

      {% comment %} 公告栏 {% endcomment %}
      {%- capture sp_announcement_content -%}
        <p class="announcement-bar-w__text">
          <span class="announcement-bar-w__intro">Vremenski ograničen program potpore za rehabilitaciju:</span>
          <strong class="announcement-bar-w__offer">Uštedite do <span class="js-bind-discount-percent">60%</span> danas · 30 dana probnog razdoblja bez rizika</strong>
        </p>
      {%- endcapture -%}
      <div class="announcement-bar-w common-pc--hide">
        {{ sp_announcement_content }}
      </div>

      {% comment %} 头部 {% endcomment %}
        <div class="announcement-bar-w common-mb--hide">
          {{ sp_announcement_content }}
        </div>
      <section class="sph" id="sp-shopping-header" data-sp-header aria-label="Page header">
        {%- liquid
          assign sph_logo = logo | default: '' | strip
          if sph_logo == blank and settings.logo != blank
            assign sph_logo = settings.logo | image_url: width: 600
          endif
          if sph_logo == blank
            assign sph_logo = 'https://cdn.shopify.com/s/files/1/0688/0460/8043/files/6888a41632338a4443544e81_EMSense_20logo.svg?v=1791771380'
          endif
        -%}
        <div class="sph__bar">
          <div class="sph__inner ">
            <div class="sph__left">
              <a
                class="sph__logo sph__scroll"
                href="{{ routes.root_url }}"
                aria-label="{{ shop.name | escape }}"
              >
                <img
                  src="{{ sph_logo }}"
                  alt="{{ shop.name | escape }}"
                  width="178"
                  height="48"
                  loading="eager"
                  decoding="async"
                >
              </a>
              <span class="sph__sep" aria-hidden="true"></span>
              <span class="sph__tagline">Plaćanje pouzećem</span>
            </div>

            <div class="sph__right">
              <nav class="sph__nav" aria-label="Section navigation">
                <button class="sph__nav-link js-size-guide" type="button">
                  <img class="sph__nav-icon" src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_size-chart.svg?v=1791863371" alt="" width="24" height="24">
                  <span>Tablica veličina</span>
                </button>
                <a class="sph__nav-link sph__scroll" href="#bewertungen" data-sph-target="bewertungen">
                  <img class="sph__nav-icon" src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_reviews.svg?v=1791863371" alt="" width="24" height="24">
                  <span>Recenzije</span>
                </a>
               
                <a class="sph__nav-link sph__scroll" href="#faq" data-sph-target="faq">
                  <img class="sph__nav-icon" src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_faq.svg?v=1791863371" alt="" width="24" height="24">
                  <span>Česta pitanja</span>
                </a>
              </nav>

              <button class="sph__cart js-cart" type="button" aria-label="Open shopping cart">
                <svg class="sph__cart-icon sph__cart-icon--pc" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16l1 13H3L4 7Zm4 0V5a4 4 0 0 1 8 0v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <img class="sph__cart-icon sph__cart-icon--mb" src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_cart.svg?v=1791863579" alt="" width="28" height="28">
                <span class="text">KOŠARICA</span>
                <span class="sph__cart-count js-cardNum{% if cart.item_count < 1 %} sp-gray{% endif %}">
                  {{- cart.item_count -}}
                </span>
              </button>

              <a class="sph__cta sph__scroll" href="#shopping" data-sph-target="shopping">
                <span>KUPITE SADA</span>
              </a>

              <button
                type="button"
                class="sph__menu-toggle js-header-menu-btn"
                aria-label="Open navigation menu"
                aria-expanded="false"
                aria-controls="sph-drawer"
              >
                <img class="sph__menu-icon" src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_menu.svg?v=1791863579" alt="" width="27" height="24">
              </button>
            </div>
          </div>
        </div>

        <div class="sph__drawer-backdrop js-header-menu-btn" data-header-menu aria-hidden="true"></div>
        <aside class="sph__drawer" id="sph-drawer" data-header-menu aria-hidden="true" inert role="dialog" aria-modal="true" aria-labelledby="sph-drawer-title">
          <div class="sph__drawer-head">
            <strong id="sph-drawer-title">Izbornik</strong>
            <button type="button" class="sph__drawer-close js-header-menu-btn" aria-label="Close navigation menu">
              ×
            </button>
          </div>
          <nav class="sph__drawer-nav" aria-label="Mobile navigation">
            <button class="sph__drawer-link js-size-guide" type="button" data-sp-header-menu-close>
              <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_size-chart.svg?v=1791863371" alt="" width="20" height="20">
              <span>Tablica veličina</span>
            </button>
            <a class="sph__drawer-link sph__scroll" href="#bewertungen" data-sph-target="bewertungen" data-sp-header-menu-close>
              <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_reviews.svg?v=1791863371" alt="" width="20" height="20">
              <span>Recenzije</span>
            </a>
            <a class="sph__drawer-link sph__scroll" href="#faq" data-sph-target="faq" data-sp-header-menu-close>
              <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_faq.svg?v=1791863371" alt="" width="20" height="20">
              <span>Česta pitanja</span>
            </a>
            <button class="sph__drawer-link js-cart" type="button" data-sp-header-menu-close>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16l1 13H3L4 7Zm4 0V5a4 4 0 0 1 8 0v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span
                >Košarica (<span class="js-cardNum">{{ cart.item_count }}</span>)</span
              >
            </button>
            <a class="sph__drawer-link sph__drawer-buy sph__scroll" href="#shopping" data-sph-target="shopping" data-sp-header-menu-close>KUPITE SADA</a>
          </nav>
        </aside>
      </section>

      {% comment %} 首屏介绍 {% endcomment %}
      <section class="ems-hero" id="produkt">
        <div class="ems-shell ems-hero__inner">
          <div class="ems-hero__media reveal-on-scroll">
            <div class="ems-hero__animation">
              <video
                class="ems-hero__video js-lazy-video"
                poster="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/sp1-poster.webp?v=1792548649"
                data-poster-pc="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/sp1-poster.webp?v=1792548649"
                data-poster-mb="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/1_2x_e84666e8-829d-460b-b8c7-dab9a398782b.webp?v=1792552170"
                data-src-pc="https://cdn.shopify.com/videos/c/o/v/48c4d456acb14724b6fc40535874fb53.mp4"
                data-src-mb="https://cdn.shopify.com/videos/c/o/v/5c6dfa42dc6341f6b27aa4275fb10ef5.webm"
                width="562"
                height="746"
                muted
                loop
                playsinline
                preload="none"
                aria-label="Zip-up orthopedic walking shoes"
              >
              </video>
            </div>
          </div>
          <div class="ems-hero__copy">
            <div class="ems-hero__rating">
              <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_banner_rating.svg?v=1791874211" alt="Trustpilot rating: 4.9 out of 5" width="224" height="22" loading="eager">
            </div>
            <p class="ems-hero__subtitle">MEDICINSKA NOVOST ODJEKUJE EUROPOM</p>
            <h1 class="ems-hero__title">Europa slavi napredak u ublažavanju boli u stopalima koji se nekad smatrao nemogućim*</h1>
            <div class="ems-hero__lead">
              <p>Tisuće ljudi diljem Europe slave iznimno ortopedsko otkriće koje djeluje na skriveni uzrok bolnih koraka. Podiže spuštene svodove stopala, stabilizira hod i ublažava snažne udarce o tlo te tako ublažava bol i vraća lakše, snažnije i sigurnije kretanje.</p>

            </div>
            <ul class="ems-check-list">
              <li><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_banner_wide-toe.webp?v=1791874143" alt="" width="37" height="29"><span><strong>Potpora svodu stopala </strong> pomaže u liječenju plantarnog fascitisa i ispravlja spuštene svodove stopala.*</span></li>
              <li><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_banner_flexible-sole.webp?v=1791874143" alt="" width="37" height="29"><span><strong>Amortizirana peta </strong> ublažava bol u peti ravnomjerno raspoređujući udarce.*</span></li>
              <li><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_banner_arch-support.webp?v=1791874144" alt="" width="37" height="29"><span><strong>Protuklizni potplat </strong> poboljšava ravnotežu te sprječava poskliznuća i padove.*</span></li>
            </ul>
            <a class="common-button ems-cta ems-hero__cta" href="#shopping">
              <span class="ems-hero__cta-label"><span class="js-bind-discount-percent">60%</span>  POPUSTA SAMO DANAS!</span>
              <img class="ems-hero__cta-arrow" src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_arrow-icon1.svg?v=1791874256" alt="" width="42" height="42">
            </a>
            <div class="ems-hero__stock">
              <span class="ems-hero__stock-label"><img class="ems-hero__stock-clock" src="https://cdn.shopify.com/s/files/1/0990/0215/5371/files/icons8-_-96.apng?v=1783565616" alt="" width="24" height="24" loading="eager"><span>Šaljemo sutra | Trenutačne zalihe: <strong class="ems-hero__stock-quantity">Preostalo je samo 13 pari!</strong></span></span>
              
            </div>
            <p class="ems-hero__secure">🔒 Zajamčeno sigurno plaćanje | SSL zaštita 🔒</p>
          </div>
        </div>

        <div class="ems-shell ems-benefits reveal-on-scroll">
          <article class="ems-benefit">
            <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_banner_30-day.webp?v=1791874468" alt="" width="96" height="96" loading="lazy">
            <div><h3>30 dana jamstva povrata novca</h3><p>Ako niste zadovoljni, vraćamo vam puni iznos u roku od 30 dana</p></div>
          </article>
          <article class="ems-benefit">
            <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_banner_tracked-worldwide.webp?v=1791874468" alt="" width="96" height="96" loading="lazy">
            <div><h3>Dostava s praćenjem diljem svijeta</h3><p>Svaka narudžba uključuje praćenje u stvarnom vremenu i osiguranje od gubitka ili krađe tijekom prijevoza.</p></div>
          </article>
          <article class="ems-benefit">
            <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_banner_powered-real.webp?v=1791874468" alt="" width="96" height="96" loading="lazy">
            <div><h3>Potvrđeno od stvarnih korisnika</h3><p>Razvijeno i testirano na temelju stvarnih povratnih informacija</p></div>
          </article>
        </div>
      </section>

      {% comment %} 四项步行鞋优势 {% endcomment %}
      <section class="ems-step-benefits" aria-labelledby="ems-step-benefits-title">
        <div class="ems-step-benefits__inner">
          <h2 class="ems-step-benefits__title reveal-on-scroll" id="ems-step-benefits-title">Zašto je hodanje u ovom paru toliko drukčije?</h2>
          <div class="ems-step-benefits__grid">
            <article class="ems-step-benefits__card reveal-on-scroll">
              <video class="ems-step-benefits__image js-lazy-video" poster="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/sp1-poster1.webp?v=1792548651" width="290" height="356" muted loop playsinline preload="none" aria-label="Man holding green orthopedic walking shoes">
                <source data-src="https://cdn.shopify.com/videos/c/o/v/dcf1ef09793e4083b04b7a352dedc3a0.webm" type="video/webm">
              </video>
              <div class="ems-step-benefits__body">
                <h3 class="ems-step-benefits__heading"><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_correct.svg?v=1791877732" alt="" width="20" height="20" loading="lazy"><span>Podupiru spuštene svodove stopala</span></h3>
                <p class="ems-step-benefits__description">Ugrađena potpora svodu stopala podiže spuštene svodove, ispravlja položaj stopala i poboljšava stabilnost pri hodanju.*</p>
              </div>
            </article>
            <article class="ems-step-benefits__card reveal-on-scroll">
              <video class="ems-step-benefits__image js-lazy-video" poster="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/sp1-poster2.webp?v=1792548648" width="290" height="356" muted loop playsinline preload="none" aria-label="Man wearing walking shoes in a vineyard">
                <source data-src="https://cdn.shopify.com/videos/c/o/v/4bfa48484e494ada905438b4861e124e.webm" type="video/webm">
              </video>
              <div class="ems-step-benefits__body">
                <h3 class="ems-step-benefits__heading"><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_correct.svg?v=1791877732" alt="" width="20" height="20" loading="lazy"><span>Smanjuju pritisak na prednji dio stopala</span></h3>
                <p class="ems-step-benefits__description">Širi prednji dio omogućuje prstima da se rašire te ublažava bol u čukljevima i prednjem dijelu stopala.*</p>
              </div>
            </article>
            <article class="ems-step-benefits__card reveal-on-scroll">
              <video class="ems-step-benefits__image js-lazy-video" poster="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/sp1-poster3.webp?v=1792548649" width="290" height="356" muted loop playsinline preload="none" aria-label="Seated person wearing black orthopedic walking shoes">
                <source data-src="https://cdn.shopify.com/videos/c/o/v/56f627aaeb4245b4821fc1b1db15c102.webm" type="video/webm">
              </video>
              <div class="ems-step-benefits__body">
                <h3 class="ems-step-benefits__heading"><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_correct.svg?v=1791877732" alt="" width="20" height="20" loading="lazy"><span>Štite pete i zglobove</span></h3>
                <p class="ems-step-benefits__description">Dodatna amortizacija pete ublažava bol upijajući udarce prije nego što dođu do zglobova.*</p>
              </div>
            </article>
            <article class="ems-step-benefits__card reveal-on-scroll">
              <video class="ems-step-benefits__image js-lazy-video" poster="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/sp1-poster4.webp?v=1792548651" width="290" height="356" muted loop playsinline preload="none" aria-label="Man wearing light-colored walking shoes on a street">
                <source data-src="https://cdn.shopify.com/videos/c/o/v/3c171bd1272f4c32b87870a0f161e603.webm" type="video/webm">
              </video>
              <div class="ems-step-benefits__body">
                <h3 class="ems-step-benefits__heading"><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_correct.svg?v=1791877732" alt="" width="20" height="20" loading="lazy"><span>Poboljšavaju stabilnost na otvorenom</span></h3>
                <p class="ems-step-benefits__description">Široki potplat poboljšava ravnotežu na šljunku, nagibima i neravnom tlu te sprječava padove i ozljede.*</p>
              </div>
            </article>
          </div>
        </div>
      </section>

      {% comment %} Fußschmerzen Ursache {% endcomment %}
      <section class="ems-cause" id="ergebnisse">
        <div class="ems-shell">
          <div class="ems-split ems-split--media-left">
            <video class="ems-media reveal-on-scroll js-lazy-video" poster="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/sp2-poster.webp?v=1792548646" width="599" height="579" muted loop playsinline preload="none">
              <source data-src="https://cdn.shopify.com/videos/c/o/v/3d4f5e153dbb4a209acefaac2d5947a7.webm" type="video/mp4">
            </video>
            <div class="ems-rich-text stext2">
              <h2 class="ems-cause__title stitle2 reveal-on-scroll">Spušteni svodovi mogu narušiti položaj cijelog tijela</h2>

              <p>Svod stopala temelj je svakog koraka.</p>
              <p>Kada se svod spusti, gležanj se zakreće prema unutra i uvija nogu, <strong>narušava položaj koljena</strong>, a <strong>kukovi i leđa moraju to nadoknađivati.</strong></p>
              <p>Prvi znak mogu biti umorna stopala ili blaga bol u peti. S vremenom se opterećenje može prenijeti na <strong>gležnjeve, koljena, kukove ili donji dio leđa.</strong></p>
              <p>Nastavite li hodati bez ispravljanja nepravilnog položaja, <strong>opetovano opterećujete</strong> plantarnu fasciju, tetive, mišiće i zglobove.*</p>
              <p>Problemi sa stopalima s vremenom mogu utjecati na <strong>način kretanja cijelog tijela.</strong></p>
              <p>Ipak, pravilan položaj cijelog tijela još se može uspostaviti…</p>
              <a class="ems-solution stexts2" href="#shopping">
                <span>PRONAŠLI SMO RJEŠENJE!</span>
                <span class="ems-solution__arrow" aria-hidden="true"></span>
              </a>
            </div>
          </div>
          <div class="ems-stat-grid reveal-on-scroll">
            <article class="ems-stat-card" data-sp-stat-wrap>
              <div class="ems-stat-ring">
                <svg viewBox="0 0 120 120" aria-hidden="true">
                  <circle class="ems-stat-ring__track" cx="60" cy="60" r="52"></circle>
                  <circle class="ems-stat-ring__progress js-stat-progress" cx="60" cy="60" r="52" data-sp-stat-radius="52"></circle>
                </svg>
                <strong class="ems-stat-ring__value stitle2"><span class="js-stat-num" data-sp-stat-value="93">0</span><span class="ems-stat-percent">%</span></strong>
              </div>
              <p class="stexts2">prijavilo je veći umor stopala nakon dugog stajanja ili hodanja.*</p>
            </article>
            <article class="ems-stat-card" data-sp-stat-wrap>
              <div class="ems-stat-ring">
                <svg viewBox="0 0 120 120" aria-hidden="true">
                  <circle class="ems-stat-ring__track" cx="60" cy="60" r="52"></circle>
                  <circle class="ems-stat-ring__progress js-stat-progress" cx="60" cy="60" r="52" data-sp-stat-radius="52"></circle>
                </svg>
                <strong class="ems-stat-ring__value stitle2"><span class="js-stat-num" data-sp-stat-value="88">0</span><span class="ems-stat-percent">%</span></strong>
              </div>
              <p class="stexts2">primijetilo je zakretanje gležnja prema unutra na tvrdom ili neravnom tlu.*</p>
            </article>
            <article class="ems-stat-card" data-sp-stat-wrap>
              <div class="ems-stat-ring">
                <svg viewBox="0 0 120 120" aria-hidden="true">
                  <circle class="ems-stat-ring__track" cx="60" cy="60" r="52"></circle>
                  <circle class="ems-stat-ring__progress js-stat-progress" cx="60" cy="60" r="52" data-sp-stat-radius="52"></circle>
                </svg>
                <strong class="ems-stat-ring__value stitle2"><span class="js-stat-num" data-sp-stat-value="84">0</span><span class="ems-stat-percent">%</span></strong>
              </div>
              <p class="stexts2">imalo je ponavljajuću bol u peti, svodu stopala, koljenu ili kuku.*</p>
            </article>
            <article class="ems-stat-card" data-sp-stat-wrap>
              <div class="ems-stat-ring">
                <svg viewBox="0 0 120 120" aria-hidden="true">
                  <circle class="ems-stat-ring__track" cx="60" cy="60" r="52"></circle>
                  <circle class="ems-stat-ring__progress js-stat-progress" cx="60" cy="60" r="52" data-sp-stat-radius="52"></circle>
                </svg>
                <strong class="ems-stat-ring__value stitle2"><span class="js-stat-num" data-sp-stat-value="86">0</span><span class="ems-stat-percent">%</span></strong>
              </div>
              <p class="stexts2">nastavilo je nositi cipele bez odgovarajuće potpore unatoč sve nepravilnijem položaju tijela.*</p>
            </article>
          </div>
        </div>
      </section>

      {% comment %} 评分横幅 {% endcomment %}
      <section class="ems-rating-bar">
