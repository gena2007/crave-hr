                aria-controls="ems-faq-answer-1"
                data-sp-faq-trigger
              >
                <span class="ems-faq__question-text stexts2">Mogu li ove cipele ublažiti bol pri hodanju na otvorenom?</span>
                <span class="ems-faq__icon" aria-hidden="true">
                  <picture class="ems-faq__plus"><source media="(max-width: 767px)" srcset="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_faq___mb.svg?v=1791962092"><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_faq_6f3aad91-5c5c-415e-b12e-f306fa459bb9.svg?v=1791962092" alt="" width="24" height="24" loading="lazy"></picture>
                  <picture class="ems-faq__minus"><source media="(max-width: 767px)" srcset="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_faq_-_mb.svg?v=1791962092"><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_faq_1420ce0d-38ed-4e3a-b366-6b236f871c44.svg?v=1791962092" alt="" width="24" height="24" loading="lazy"></picture>
                </span>
              </button>
              <div class="ems-faq__answer" id="ems-faq-answer-1">
                <div class="ems-faq__answer-inner stext2">Da. Potpora svodu stopala ispravlja spuštene svodove, amortizacija pete ublažava udarce, a stabilni potplat kontrolira kretanje i pruža potporu bolnim stopalima tijekom duljih šetnji.</div>
              </div>
            </article>

            <article class="ems-faq__item reveal-on-scroll">
              <button
                class="ems-faq__question"
                type="button"
                aria-expanded="false"
                aria-controls="ems-faq-answer-2"
                data-sp-faq-trigger
              >
                <span class="ems-faq__question-text stexts2">Za koje su tegobe stopala osmišljene?</span>
                <span class="ems-faq__icon" aria-hidden="true">
                  <picture class="ems-faq__plus"><source media="(max-width: 767px)" srcset="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_faq___mb.svg?v=1791962092"><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_faq_6f3aad91-5c5c-415e-b12e-f306fa459bb9.svg?v=1791962092" alt="" width="24" height="24" loading="lazy"></picture>
                  <picture class="ems-faq__minus"><source media="(max-width: 767px)" srcset="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_faq_-_mb.svg?v=1791962092"><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_faq_1420ce0d-38ed-4e3a-b366-6b236f871c44.svg?v=1791962092" alt="" width="24" height="24" loading="lazy"></picture>
                </span>
              </button>
              <div class="ems-faq__answer" id="ems-faq-answer-2">
                <div class="ems-faq__answer-inner stext2">Ortopedska konstrukcija pomaže kod plantarnog fascitisa, boli u peti, prekomjerne pronacije, pritiska na čukljeve, umora svoda stopala i nestabilnosti pri hodanju. Ako je bol jaka, iznenadna ili se pogoršava, posavjetujte se s liječnikom.</div>
              </div>
            </article>

            <article class="ems-faq__item reveal-on-scroll">
              <button
                class="ems-faq__question"
                type="button"
                aria-expanded="false"
                aria-controls="ems-faq-answer-3"
                data-sp-faq-trigger
              >
                <span class="ems-faq__question-text stexts2">Jesu li prikladne za mokro ili neravno tlo?</span>
                <span class="ems-faq__icon" aria-hidden="true">
                  <picture class="ems-faq__plus"><source media="(max-width: 767px)" srcset="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_faq___mb.svg?v=1791962092"><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_faq_6f3aad91-5c5c-415e-b12e-f306fa459bb9.svg?v=1791962092" alt="" width="24" height="24" loading="lazy"></picture>
                  <picture class="ems-faq__minus"><source media="(max-width: 767px)" srcset="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_faq_-_mb.svg?v=1791962092"><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_faq_1420ce0d-38ed-4e3a-b366-6b236f871c44.svg?v=1791962092" alt="" width="24" height="24" loading="lazy"></picture>
                </span>
              </button>
              <div class="ems-faq__answer" id="ems-faq-answer-3">
                <div class="ems-faq__answer-inner stext2">Vodoodbojno gornjište štiti od lagane kiše i prskanja, a protuklizni vanjski potplat poboljšava prianjanje na pločniku, šljunku, nagibima i vlažnim stazama. Nisu namijenjene dubokoj vodi ni potpunom uranjanju.</div>
              </div>
            </article>

            <article class="ems-faq__item reveal-on-scroll">
              <button
                class="ems-faq__question"
                type="button"
                aria-expanded="false"
                aria-controls="ems-faq-answer-4"
                data-sp-faq-trigger
              >
                <span class="ems-faq__question-text stexts2">Hoće li mi zbog prostranog prednjeg dijela peta kliziti?</span>
                <span class="ems-faq__icon" aria-hidden="true">
                  <picture class="ems-faq__plus"><source media="(max-width: 767px)" srcset="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_faq___mb.svg?v=1791962092"><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_faq_6f3aad91-5c5c-415e-b12e-f306fa459bb9.svg?v=1791962092" alt="" width="24" height="24" loading="lazy"></picture>
                  <picture class="ems-faq__minus"><source media="(max-width: 767px)" srcset="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_faq_-_mb.svg?v=1791962092"><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_faq_1420ce0d-38ed-4e3a-b366-6b236f871c44.svg?v=1791962092" alt="" width="24" height="24" loading="lazy"></picture>
                </span>
              </button>
              <div class="ems-faq__answer" id="ems-faq-answer-4">
                <div class="ems-faq__answer-inner stext2">Ne. Dodatni prostor oko prstiju smanjuje pritisak na čukljeve i osjetljive zglobove. Potporna petna čašica i podesivo zatvaranje sigurno učvršćuju stražnji dio stopala tijekom uspona, spustova i duljih šetnji.</div>
              </div>
            </article>

            <article class="ems-faq__item reveal-on-scroll">
              <button
                class="ems-faq__question"
                type="button"
                aria-expanded="false"
                aria-controls="ems-faq-answer-5"
                data-sp-faq-trigger
              >
                <span class="ems-faq__question-text stexts2">Kako ih početi nositi?</span>
                <span class="ems-faq__icon" aria-hidden="true">
                  <picture class="ems-faq__plus"><source media="(max-width: 767px)" srcset="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_faq___mb.svg?v=1791962092"><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_faq_6f3aad91-5c5c-415e-b12e-f306fa459bb9.svg?v=1791962092" alt="" width="24" height="24" loading="lazy"></picture>
                  <picture class="ems-faq__minus"><source media="(max-width: 767px)" srcset="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_faq_-_mb.svg?v=1791962092"><img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_faq_1420ce0d-38ed-4e3a-b366-6b236f871c44.svg?v=1791962092" alt="" width="24" height="24" loading="lazy"></picture>
                </span>
              </button>
              <div class="ems-faq__answer" id="ems-faq-answer-5">
                <div class="ems-faq__answer-inner stext2">Počnite s kraćim šetnjama dok se stopala prilagođavaju korektivnoj potpori. Postupno produljujte nošenje kako se osjećaj udobnosti poboljšava. Vrijeme prilagodbe i rezultati razlikuju se, osobito nakon višegodišnjeg nošenja cipela bez odgovarajuće potpore.</div>
              </div>
            </article>
          </div>
                
          <a class="common-button ems-faq__cta reveal-on-scroll" href="#shopping">KUPITE SADA<img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/ID-20-YH107740_arrow-icon1.svg?v=1791874256" alt="" width="41" height="41" loading="lazy"></a>
        </div>
      </section>


      {% comment %} 尺寸弹窗 {% endcomment %}
      <div class="sp-size-modal" data-sp-size-modal aria-hidden="true">
        <div class="sp-size-modal__overlay" data-sp-size-close></div>
        <div class="sp-size-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="sp-size-modal-title">
          <button
            class="sp-size-modal__close"
            type="button"
            data-sp-size-close
            aria-label="Close size guide"
          >
            ×
          </button>
          <h2 id="sp-size-modal-title">Tablica veličina</h2>
          <div class="sp-size-modal__table-wrap">
            <section class="ems-size">
              <div class="ems-size__inner">
                <div class="ems-size__main">
                  <div class="ems-size__table-wrap reveal-on-scroll is-visible">
                    <table class="ems-size__table">
                      <thead>
                        <tr>
                          <th>EU</th>
                          <th>Duljina (mm)</th>
                          <th>EU</th>
                          <th>Duljina (mm)</th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr><td>36</td><td>230</td><td>45</td><td>275</td></tr>
                        <tr><td>37</td><td>235</td><td>46</td><td>280</td></tr>
                        <tr><td>38</td><td>240</td><td>47</td><td>285</td></tr>
                        <tr><td>39</td><td>245</td><td>48</td><td>290</td></tr>
                        <tr><td>40</td><td>250</td><td>49</td><td>295</td></tr>
                        <tr><td>41</td><td>255</td><td>50</td><td>300</td></tr>
                        <tr><td>42</td><td>260</td><td>51</td><td>305</td></tr>
                        <tr><td>43</td><td>265</td><td>52</td><td>310</td></tr>
                        <tr><td>44</td><td>270</td><td>53</td><td>315</td></tr>
                      </tbody>
                    </table>
                  </div>

                  <div class="ems-size__aside reveal-on-scroll is-visible">
                    <div class="ems-size__guarantee">
                      <img class="ems-size__guarantee-img" src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/30day-18.png?v=1791529439" alt="30 Days Money Back Guarantee" width="92" height="92" loading="lazy" decoding="async">
                      <div class="ems-size__guarantee-text">
                        <strong>Brinete se da vam veličina neće odgovarati?</strong>
                        <p class="stext2">
                          Bez brige — imate 30 dana da ih isprobate. Ako vam veličina ne odgovara, povrat i zamjena su besplatni.
                        </p>
                      </div>
                    </div>

                    <picture class="ems-size__measure">
                      <source media="(max-width: 767px)" srcset="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105674-measurement-mb.webp?v=1787552916">
                      <img src="https://cdn.shopify.com/s/files/1/0688/0460/8043/files/YH105674-measurement.webp?v=1787552916" alt="How to measure foot size" width="640" height="360" loading="lazy" decoding="async">
                    </picture>

                    <ul class="ems-size__tips stext2">
                      <li>Pri mjerenju nosite čarape i stojte prirodno.</li>
                      <li>Dopušteno odstupanje pri mjerenju iznosi 0.3–0.5 cm.</li>
                      <li>Ako ste između veličina, odaberite veću.</li>
                    </ul>
                  </div>
                </div>
              </div>
            </section>
          </div>
        </div>
      </div>
      {% comment %} 购物车底部加购模块 {% endcomment %}
      <div class="sp-shopping-drawer">
        <div class="sp-cart-drawer-overlay" data-sp-drawer-overlay aria-hidden="true"></div>
        <aside class="sp-cart-drawer" data-sp-cart-drawer aria-hidden="true" aria-label="Shopping cart">
          <div class="sp-cart-drawer__header">
            <h2 class="sp-cart-drawer__heading">Košarica (<span class="js-cardNum">0</span>)</h2>
            <button
              class="sp-cart-drawer__close"
              type="button"
              data-sp-drawer-close
              aria-label="Close shopping cart"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
            </button>
          </div>

          <div class="sp-cart-drawer__notice">✓ Sigurno plaćanje · Brza dostava · Jednostavan povrat</div>

          <div class="sp-cart-drawer__body">
            <div class="sp-cart-drawer__loading" data-sp-cart-loading>Učitavanje košarice…</div>

            <div class="sp-cart-drawer__empty" data-sp-cart-empty>
              <div class="sp-cart-drawer__empty-icon">🛒</div>
              <p>Vaša je košarica trenutačno prazna.</p>
              <button class="sp-cart-drawer__continue" type="button" data-sp-drawer-close>Nastavi kupovati</button>
            </div>

            <div class="sp-cart-drawer__items" data-sp-cart-items aria-live="polite"></div>
          </div>

          <div class="sp-cart-drawer__footer" data-sp-cart-footer hidden>
            <div class="sp-cart-drawer__note js-cart-drawer__note">
              <button
                class="sp-cart-drawer__note-toggle"
                type="button"
                aria-expanded="false"
                aria-controls="sp-cart-note-panel"
                data-sp-cart-note-toggle
              >
                <span data-sp-cart-note-toggle-label>Dodaj napomenu uz narudžbu</span>
                <span class="sp-cart-drawer__note-chevron" aria-hidden="true">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10 6l-1.41 1.41L13.17 12l-4.58 4.59L10 18l6-6z" fill="#000"></path>
                  </svg>
                </span>
              </button>
              <div class="sp-cart-drawer__note-panel" id="sp-cart-note-panel" data-sp-cart-note-panel hidden>
                {% comment %} <label class="sp-cart-drawer__note-label" for="sp-cart-note">Order note</label> {% endcomment %}
                <textarea
                  class="sp-cart-drawer__note-input"
                  id="sp-cart-note"
                  maxlength="500"
                  placeholder="Add delivery instructions or a note about your order"
                  data-sp-cart-note
                ></textarea>
                <div class="sp-cart-drawer__note-actions">
                  <span class="sp-cart-drawer__note-status" data-sp-cart-note-status aria-live="polite"></span>
                  <button class="sp-cart-drawer__note-save" type="button" data-sp-cart-note-save>Spremi napomenu</button>
                </div>
              </div>
            </div>
            <div class="sp-cart-drawer__subtotal">
              <span>Međuzbroj</span>
              <span class="sp-cart-drawer__subtotal-value" data-sp-cart-total></span>
            </div>
            <p class="sp-cart-drawer__tax-note">Porezi i dostava obračunavaju se pri plaćanju.</p>
            <a class="sp-cart-drawer__checkout js-cart-drawer__checkout" href="/checkout"> Sigurno plaćanje </a>
          </div>
        </aside>
      </div>
      <!-- 页面底部加购模块 -->
      <div class="sp-fixed-purchase-mount">
        <section class="sp-fixed-purchase" data-sp-fixed-purchase aria-label="Quick purchase">
          <div class="sp-fixed-purchase__inner">
            <div class="sp-fixed-purchase__product">
              {%- assign sp_fixed_product_image = product.selected_or_first_available_variant.featured_image
                | default: product.featured_image
              -%}
              {%- if sp_fixed_product_image -%}
                {%- assign sp_fixed_product_image_url = sp_fixed_product_image
                  | image_url: width: sp_fixed_product_image.width
                  | split: '&width='
                  | first
                -%}
              {%- else -%}
                {%- assign sp_fixed_product_image_url = '' -%}
              {%- endif -%}
              <img
                class="sp-fixed-purchase__image js-bind-image"
                src="{{ sp_fixed_product_image_url }}"
                alt="{{ product.title | escape }}"
                width="80"
                height="80"
              >
              <div class="sp-fixed-purchase__meta">
                <p class="sp-fixed-purchase__title js-bind-title">{{ product.title }}</p>
                <div class="sp-fixed-purchase__prices">
                  <span class="sp-fixed-purchase__price js-bind-price"></span>
                  <span class="sp-fixed-purchase__compare js-bind-compare"></span>
                </div>
              </div>
            </div>

            {%- unless product.has_only_default_variant -%}
              <div class="sp-fixed-purchase__options">
                {%- for option in product.options_with_values -%}
                  <select
                    class="sp-fixed-purchase__select js-variant-select"
                    data-option-index="{{ forloop.index0 }}"
                    aria-label="{{ option.name | escape }}"
                  >
                    <option value="" selected>{{ option.name | escape }}</option>
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}">
                        {{ value | escape }}
                      </option>
                    {%- endfor -%}
                  </select>
                {%- endfor -%}
              </div>
            {%- endunless -%}

            <div class="sp-fixed-purchase__actions">
              <div class="sp-fixed-purchase__qty" aria-label="Quantity">
                <button class="js-reduce" type="button" aria-label="Decrease quantity">−</button>
                <input
                  class="js-calcNumber"
                  type="number"
                  min="1"
                  max="200"
                  value="1"
                  inputmode="numeric"
                  aria-label="Quantity"
                >
                <button class="js-add" type="button" aria-label="Increase quantity">+</button>
              </div>

              <button
                class="sp-fixed-purchase__cart js-fixed-purchase__cart js-add-cart"
                type="button"
                aria-label="Add to cart"
              >
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d="M3 4h2l2.2 10.1a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 1.9-1.4L21 7H6M10 20a1 1 0 1 1-2 0 1 1 0 0 1 2 0Zm9 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z"
                    stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="js-cardNum{% if cart.item_count < 1 %} sp-gray{% endif %}">{{ cart.item_count }}</span>
              </button>

              <button class="sp-fixed-purchase__buy js-buy-now" type="button">KUPITE SADA</button>
            </div>
          </div>
        </section>
      </div>
      {% comment %} 回到顶部 {% endcomment %}
      <button class="sp-to-top" type="button" aria-label="Back to top" title="Back to top" >
        <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="26.8531494140625" height="26.99560546875" viewBox="0 0 26.8531494140625 26.99560546875" fill="none">
          <path d="M20.7364 12.1686L0.999976 12.4304L0.999976 14.8068L21.0184 14.545L11.6838 23.8796L13.3856 25.5813L25.4389 13.528L25.4087 13.4978L25.4389 13.4676L13.3856 1.41423L11.6838 3.11599L20.7364 12.1686Z" stroke="var(--primary-color,#000)" stroke-width="2" fill-rule="evenodd" fill="#3D9100"></path>
        </svg>
      </button>

    </div>

    {% comment %} 产品需要的数据 {% endcomment %}
    <script>
      window.product = {{ product.variants | json }}; {% comment %} 产品数据 {% endcomment %}
      window.options = {{ product.options_with_values | json }}; {% comment %} 产品选项数据 {% endcomment %}
      window.cartCount = {{ cart.item_count | json }}; {% comment %} 购物车数量 {% endcomment %}
      window.shopMoneyFormat = {{ shop.money_format | json }}; {% comment %} 商店货币格式 {% endcomment %}
      window.spCurrencyCode = {{ cart.currency.iso_code | default: localization.country.currency.iso_code | json }}; {% comment %} 商店货币代码 {% endcomment %}
      window.spLocale = {{ request.locale.iso_code | json }}; {% comment %} 商店语言代码 {% endcomment %}
      window.spSelectedVariantId = {{ product.selected_or_first_available_variant.id | json }}; {% comment %} 产品选定变体ID {% endcomment %}
      window.spProductTitle = {{ product.title | json }}; {% comment %} 产品标题 {% endcomment %}
    </script>

    <script src="{{ 'jquery.min.js' | asset_url }}" defer></script>
    <script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
    <script src="https://cdn.shopify.com/s/files/1/0807/0086/6801/files/ID-27-YH105725-HR.js?v=1792658715" defer></script>
    
  </body>
</html>
