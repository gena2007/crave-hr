"<div class=\"ida-countdown-container\" id=\"ida-countdown-timer\">\n  <svg class=\"ida-countdown-icon\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"rgb(var(--color-button))\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n    <circle cx=\"12\" cy=\"12\" r=\"10\"><\/circle>\n    <polyline points=\"12 6 12 12 16 14\"><\/polyline>\n  <\/svg>\n\n  <div class=\"ida-countdown-text\">\n    <div class=\"ida-countdown-label-line1\">Akcija završava danas u 23:59<\/div>\n<div class=\"ida-countdown-label-line2\">\n  <span class=\"ida-countdown-label\">Preostalo vrijeme ponude:<\/span>\n      <span class=\"ida-countdown-time\">\n        <span class=\"ida-countdown-hours\">00<\/span>:\n        <span class=\"ida-countdown-minutes\">00<\/span>:\n        <span class=\"ida-countdown-seconds\">00<\/span>\n      <\/span>\n    <\/div>\n  <\/div>\n<\/div>\n\n<script>\nconst timerEl = document.getElementById('ida-countdown-timer');\nconst hoursEl = timerEl.querySelector('.ida-countdown-hours');\nconst minutesEl = timerEl.querySelector('.ida-countdown-minutes');\nconst secondsEl = timerEl.querySelector('.ida-countdown-seconds');\n\nfunction getLocalParts() {\n  const now = new Date();\n  const opts = {\n    timeZone: 'Europe\/Zagreb',\n    hour:'2-digit',minute:'2-digit',second:'2-digit',day:'2-digit',month:'2-digit',year:'numeric',\n    hour12: false\n  };\n  const parts = new Intl.DateTimeFormat('en-US', opts).formatToParts(now);\n  const obj = {};\n  parts.forEach(p=>obj[p.type]=p.value);\n  return {\n    year: Number(obj.year),\n    month: Number(obj.month)-1,\n    day: Number(obj.day),\n    hour: Number(obj.hour),\n    minute: Number(obj.minute),\n    second: Number(obj.second),\n  }\n}\n\nfunction updateCountdown() {\n  const t = getLocalParts();\n  const nowLocal = new Date(t.year, t.month, t.day, t.hour, t.minute, t.second);\n  const endDayLocal = new Date(t.year, t.month, t.day, 23,59,59,999);\n\n  let remainingSeconds = Math.floor((endDayLocal - nowLocal) \/ 1000);\n  if(remainingSeconds < 0) remainingSeconds = 0;\n\n  const hours = Math.floor(remainingSeconds \/ 3600);\n  const minutes = Math.floor((remainingSeconds % 3600) \/ 60);\n  const seconds = remainingSeconds % 60;\n\n  hoursEl.textContent = hours.toString().padStart(2,'0');\n  minutesEl.textContent = minutes.toString().padStart(2,'0');\n  secondsEl.textContent = seconds.toString().padStart(2,'0');\n}\n\nupdateCountdown();\nsetInterval(updateCountdown,1000);\n<\/script>\n\n\n<style>\n.ida-countdown-container {\n  display: flex;\n  align-items: flex-start;\n  gap: 10px;\n  font-family: inherit;\n  padding: 0;\n  border-radius: 8px;\nbackground:#fff;\npadding:0px;\n}\n\n.ida-countdown-icon {\n  flex-shrink: 0;\n  margin-top: auto;\n  margin-bottom: auto;\n}\n\n.ida-countdown-text {\n  display: flex;\n  flex-direction: column;\n}\n\n.ida-countdown-label-line1 {\n  font-size: 15px;\n  color: #3d2f16;\n  margin-bottom: 2px;\n}\n\n.ida-countdown-label-line2 {\n  display: flex;\n  align-items: center;\n  font-size: 15px;\n  color: #3d2f16;\n  gap: 4px;\n}\n\n.ida-countdown-label-line2 .ida-countdown-time {\n  font-weight: 600;\n  font-size: 16px;\n  color: rgb(var(--color-button));\n  letter-spacing: 0.5px;\n  display: flex;\n  align-items: center;\n  gap: 4px;\n}\n\n@media (max-width: 768px) {\n  .ida-countdown-container {\n    gap: 8px;\n    margin-left: 5px;\n  }\n  .ida-countdown-icon {\n    width: 20px;\n    height: 20px;\n  }\n  .ida-countdown-label-line1,\n  .ida-countdown-label-line2 {\n    font-size: 13px;\n  }\n  .ida-countdown-label-line2 .ida-countdown-time {\n    font-size: 15px;\n    gap: 2px;\n  }\n}\n<\/style>"}},"custom_liquid_Gd843c":{"type":"custom_liquid","settings":{"custom_liquid":"<div style=\"margin: 0; padding: 0;color:#29252c;\">\n  <div style=\"display: flex; align-items: center; margin-bottom: 10px;\">\n     <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\