  month: 'long',\n    timeZone: shopTimezone\n  };\n  \n  \/\/ Obter a data actual\n  const today = new Date();\n  \n  \/\/ Calcular as datas: hoje +7 dias e hoje +10 dias\n  const firstDate = new Date(today);\n  firstDate.setDate(today.getDate() + 7);\n  \n  const secondDate = new Date(today);\n  secondDate.setDate(today.getDate() + 10);\n  \n  \/\/ Formatar as datas para o idioma português\n  const firstDateFormatted = new Intl.DateTimeFormat('hr-HR', options).format(firstDate);\n  const secondDateFormatted = new Intl.DateTimeFormat('hr-HR', options).format(secondDate);\n  \n  \/\/ Actualizar os elementos do DOM\n  document.getElementById('firstDate').textContent = firstDateFormatted;\n  document.getElementById('secondDate').textContent = secondDateFormatted;\n};\n<\/script>"}},"variant_picker":{"type":"variant_picker","settings":{"picker_type":"button","swatch_shape":"circle"}},"size_charts_jotly_jotly_size_chart_block_EAPTY4":{"type":"shopify:\/\/apps\/size-charts-jotly\/blocks\/jotly-size-chart-block\/97eaca86-aad8-492c-9d4d-0dfdc4899889","settings":{}},"quantity_selector":{"type":"quantity_selector","settings":{}},"custom_liquid_N6xcAC":{"type":"custom_liquid","settings":{"custom_liquid":"<style>\n  .stock-level {\n    display: flex;\n    align-items: center;\n    justify-content: center; \n    margin: 8px 1px;\n    font-size:16px;\n  }\n  .stock-grid {\n    display: flex;\n    margin: 0 8px;\n  }\n  .stock-grid-item {\n    width: 16px;\n    height: 16px;\n    border: 1px solid #ddd;\n    margin-right: 4px;\n  }\n  .stock-grid-item.filled {\n    background-color: rgb(var(--color-button));\n    animation: 1.2s ease 0s infinite normal none running pulse;\n  }\n  @keyframes pulse {\n    0%, 100% {\n      transform: scale(1);\n    }\n    50% {\n      opacity: 0.5;\n      transform: scale(1.2);\n    }\n  }\n  @media (max-width: 768px) {  \n    .stock-level {\n      font-size:14px;\n    }\n  }\n<\/style>\n\n<div class=\"stock-level\">\n  Stanje zaliha: \n  <div clas