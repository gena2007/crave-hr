{"sections":{"main":{"type":"main-product","blocks":{"custom_liquid_YzffeN":{"type":"custom_liquid","settings":{"custom_liquid":"<style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        .ida-bar-container {\n            max-width: 100%;\n            overflow: hidden;\n            background: #fff;\n            border: 1px solid rgb(var(--color-button));\n            border-radius: 8px;\n        }\n\n        .ida-bar-wrapper {\n            position: relative;\n            height: 50px;\n            display: flex;\n            padding: 0 16px;\n        }\n\n        .ida-bar-slide {\n            display: flex;\n            align-items: center;\n            gap: 8px;\n            width: 100%;\n            position: absolute;\n            top: 0;\n            left: 8px;\n            right: 5px;\n            opacity: 0;\n            transition: opacity 0.5s ease-in-out;\n            margin-top: auto;\n            margin-bottom: auto;\n            height: 100%;\n            display: flex;\n            align-items: center;\n        }\n\n        .ida-bar-slide.active {\n            opacity: 1;\n        }\n\n        .ida-bar-icon {\n            width: 20px;\n            height: 20px;\n            flex-shrink: 0;\n        }\n\n        .ida-bar-text {\n            font-size: 14px;\n            color: #29252C;\n            line-height: 1.4;\n            flex: 1;\n        }\n\n        @media (max-width: 768px) {\n            .ida-bar-wrapper {\n                height: 50px;\n                padding: 0 12px;\n            }\n            .ida-bar-icon {\n                width: 18px;\n                height: 18px;\n            }\n            .ida-bar-text {\n                font-size: 13px;\n            }\n        }\n    <\/style>\n<body>\n    <div class=\"ida-bar-container\">\n        <div class=\"ida-bar-wrapper\" id=\"idaBarWrapper\">\n            <div class=\"ida-bar-slide active\">\n                <img src=