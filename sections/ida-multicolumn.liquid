{%- comment -%}
  IDA Custom Multicolumn Slider
  Features: Customizable card styles, Native CSS Scroll Snap.
  Updates: Added Image Width control and Circle Aspect Ratio option.
  Prefix: ida-
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --ida-padding-top: {{ section.settings.padding_top }}px;
    --ida-padding-bottom: {{ section.settings.padding_bottom }}px;
    --ida-bg-color: {{ section.settings.bg_color }};
    
    /* Card Variables */
    --ida-card-bg: {{ section.settings.card_bg }};
    --ida-card-text: {{ section.settings.card_text_color }};
    --ida-card-radius: {{ section.settings.card_radius }}px;
    --ida-card-border-width: {{ section.settings.card_border_width }}px;
    --ida-card-border-color: {{ section.settings.card_border_color }};
    --ida-card-shadow: {% if section.settings.show_shadow %}0 4px 20px rgba(0,0,0,0.08){% else %}none{% endif %};
    --ida-card-padding: {{ section.settings.card_padding }}px;
    --ida-grid-gap: {{ section.settings.grid_gap }}px;
    
    /* Layout Variables */
    --ida-col-desktop: {{ section.settings.col_desktop }};
    --ida-col-mobile: {{ section.settings.col_mobile }};
  }

  .ida-section {
    background-color: var(--ida-bg-color);
    padding-top: var(--ida-padding-top);
    padding-bottom: var(--ida-padding-bottom);
    overflow: hidden;
  }

  .ida-container {
    max-width: {{ section.settings.page_width }}px;
    margin: 0 auto;
    padding: 0 1.5rem;
    position: relative;
  }

  .ida-header {
    text-align: {{ section.settings.title_align }};
    margin-bottom: 3rem;
  }
  
  .ida-desc {
    text-align: {{ section.settings.title_align }};
    color: #6c757d;
    font-size: 22px;
  }

  .ida-title {
    margin: 0 0 1rem;
    font-size: {{ section.settings.title_size }}px;
    line-height: 1.2;
    color: var(--ida-card-text);
  }

  .ida-track {
    display: flex;
    gap: var(--ida-grid-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 2rem;
    margin-right: -1.5rem;
    padding-right: 1.5rem;
    scrollbar-width: none;
  }
  .ida-track::-webkit-scrollbar { display: none; }

  .ida-track.ida-is-grid {
    flex-wrap: wrap;
    overflow-x: visible;
    scroll-snap-type: none;
    margin-right: 0;
    padding-right: 0;
  }

  .ida-card-item {
    flex: 0 0 auto;
    width: calc((100% - (var(--ida-col-mobile) - 1) * var(--ida-grid-gap)) / var(--ida-col-mobile));
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    background-color: var(--ida-card-bg);
    border-radius: var(--ida-card-radius);
    border: var(--ida-card-border-width) solid var(--ida-card-border-color);
    box-shadow: var(--ida-card-shadow);
    overflow: hidden;
    transition: transform 0.3s ease;
    color: var(--ida-card-text);
  }

  @media screen and (min-width: 768px) {
    .ida-card-item {
      width: calc((100% - (var(--ida-col-desktop) - 1) * var(--ida-grid-gap)) / var(--ida-col-desktop));
    }
  }

  /* Image Container Logic */
  .ida-media-container {
    display: flex;
    width: 100%;
    /* Align image within the card based on content alignment */
    justify-content: {% if section.settings.center_content %}center{% else %}flex-start{% endif %};
    padding: {% if section.settings.image_width != '100%' %}var(--ida-card-padding) var(--ida-card-padding) 0{% else %}0{% endif %};
  }

  .ida-media {
    position: relative;
    overflow: hidden;
    width: {{ section.settings.image_width }};
    {% if section.settings.image_ratio == 'circle' %}
      aspect-ratio: 1 / 1;
      border-radius: 50%;
    {% else %}
      aspect-ratio: {{ section.settings.image_ratio }};
    {% endif %}
  }

  .ida-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ida-content {
    padding: var(--ida-card-padding);
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    {% if section.settings.center_content %}
      text-align: center;
      align-items: center;
    {% else %}
      text-align: left;
      align-items: flex-start;
    {% endif %}
  }

  .ida-card-heading { margin: 0 0 0.5rem; font-size: 2.25rem; }
  .ida-card-text { margin-bottom: 1.5rem; line-height: 1.5; flex-grow: 1; }

  .ida-btn {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    background-color: {{ section.settings.btn_bg }};
    color: {{ section.settings.btn_text }};
    text-decoration: none;
    border-radius: 4px;
  }

  .ida-nav-btn {
    display: none!important;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: #fff;
    border: 1px solid #e5e5e5;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    z-index: 2;

    align-items: center;
    justify-content: center;
  }
  .ida-prev { left: 0; }
  .ida-next { right: 0; }

  @media screen and (max-width: 767px) {
    .ida-nav-btn { display: none; }
    .ida-title { font-size: 26px; }
    .ida-desc { font-size: 16px; }
  .ida-card-heading { margin: 0 0 0.5rem; font-size: 2rem; }
  }
{%- endstyle -%}

<div class="ida-section">
  <div class="ida-container">
    {%- if section.settings.title != blank -%}
      <div class="ida-header">
        <h2 class="ida-title">{{ section.settings.title }}</h2>
      </div>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <div class="ida-desc">{{ section.settings.description }}</div>
    {%- endif -%}

    <div class="ida-slider-wrapper">
      {%- if section.settings.enable_slider -%}
        <button class="ida-nav-btn ida-prev" onclick="idaScroll('{{ section.id }}', -1)">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
      {%- endif -%}

      <div id="ida-track-{{ section.id }}" class="ida-track {% unless section.settings.enable_slider %}ida-is-grid{% endunless %}">
        {%- for block in section.blocks -%}
          <div class="ida-card-item" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="ida-media-container">
                <div class="ida-media">
                  {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy' }}
                </div>
              </div>
            {%- endif -%}
            <div class="ida-content">
              {%- if block.settings.title != blank -%}
                <h2 class="ida-card-heading">{{ block.settings.title }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="ida-card-text rte">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if block.settings.link_label != blank -%}
                <a href="{{ block.settings.link }}" class="ida-btn">{{ block.settings.link_label }}</a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.enable_slider -%}
        <button class="ida-nav-btn ida-next" onclick="idaScroll('{{ section.id }}', 1)">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  function idaScroll(id, dir) {
    const track = document.getElementById(`ida-track-${id}`);
    const item = track.querySelector('.ida-card-item');
    if (track && item) {
      track.scrollBy({ left: dir * (item.offsetWidth + 24), behavior: 'smooth' });
    }
  }
</script>

{% schema %}
{
  "name": "IDA Multicolumn Slider",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "page_width",
      "min": 1000,
      "max": 1600,
      "step": 50,
      "default": 1200,
      "unit": "px",
      "label": "Max Page Width"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "default": 60, "unit": "px", "label": "Top Padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "default": 60, "unit": "px", "label": "Bottom Padding"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main Heading",
      "default": "Our Services"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>描述</p>"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16, "max": 60, "step": 2, "default": 32, "unit": "px", "label": "Heading Size"
    },
    {
      "type": "select",
      "id": "title_align",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center", "label": "Heading Alignment"
    },
    {
      "type": "header",
      "content": "Slider & Grid"
    },
    {
      "type": "checkbox",
      "id": "enable_slider",
      "label": "Enable Slider",
      "default": true
    },
    {
      "type": "range",
      "id": "col_desktop",
      "min": 1, "max": 6, "step": 1, "default": 4, "label": "Desktop Columns"
    },
    {
      "type": "range",
      "id": "col_mobile",
      "min": 1, "max": 3, "step": 0.5, "default": 1.5, "label": "Mobile Columns"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 0, "max": 50, "step": 2, "default": 24, "unit": "px", "label": "Gap"
    },
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "circle", "label": "Circle" },
        { "value": "auto", "label": "Adapt to image" }
      ],
      "default": "4 / 3",
      "label": "Image Aspect Ratio"
    },
    {
      "type": "select",
      "id": "image_width",
      "options": [
        { "value": "33.33%", "label": "1/3 Column Width" },
        { "value": "50%", "label": "1/2 Column Width" },
        { "value": "100%", "label": "Full Column Width" }
      ],
      "default": "100%",
      "label": "Image Width"
    },
    {
      "type": "header",
      "content": "Card Styles"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#f8f8f8"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card Text Color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0, "max": 40, "step": 1, "default": 12, "unit": "px", "label": "Corner Radius"
    },
    {
      "type": "range",
      "id": "card_border_width",
      "min": 0, "max": 5, "step": 1, "default": 0, "unit": "px", "label": "Border Width"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Border Color",
      "default": "#e5e5e5"
    },
    {
      "type": "checkbox",
      "id": "show_shadow",
      "label": "Show Shadow",
      "default": false
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 0, "max": 60, "step": 2, "default": 24, "unit": "px", "label": "Inner Padding"
    },
    {
      "type": "checkbox",
      "id": "center_content",
      "label": "Center Content",
      "default": false
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_text",
      "label": "Button Text",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Description</p>" },
        { "type": "text", "id": "link_label", "label": "Button Label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "IDA Multicolumn Slider",
      "settings": {
      "title": "How 店名® Can Help Your Body",
      "description": "<p>Our anatomically designed footwear addresses the root causes of common foot problems, rather than merely the symptoms.</p>"
    },
      "blocks": [ 
        { "type": "card",
          "settings": {
            "title": "Bunionitis",
            "text": "<p>Our spacious toe box design provides room for bunions to settle naturally.</p>"
          }
         }, 
         { "type": "card",
          "settings": {
            "title": "Plantar fasciitis",
            "text": "<p>The orthopaedic design relieves pressure on the plantar fascia.</p>"
          }
         }, { "type": "card",
          "settings": {
            "title": "Back pain",
            "text": "<p>Correct foot positioning can reduce pressure on the joints in the feet.</p>"
          }
         },
         { "type": "card",
          "settings": {
            "title": "Mobility issues",
            "text": "<p>Walk for longer, move freely and avoid daily pain.</p>"
          }
         }
        ]
    }
  ]
}
{% endschema %}