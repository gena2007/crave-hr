{%- capture ida_photo_slider_css -%}
  <style>
    #ida-{{ section.id }}.ida-photo-slider-wrapper {padding: {{section.settings.top_padding_desktop}}px 0 {{section.settings.bottom_padding_desktop}}px 0;background: {{section.settings.bg_color}}; overflow-x: hidden;}
    #ida-{{ section.id }} .ida-page-width {max-width: 1140px;width: 100%;margin: 0 auto;padding: 0 20px;}
    

    #ida-{{ section.id }} .ida-photo-slider-title {
      margin: 0 auto 30px;
      text-align: {{ section.settings.text_align }};
      max-width: 100%;
    }

    #ida-{{ section.id }} .ida-photo-slider-title h2,
    #ida-{{ section.id }} .ida-photo-slider-desc {
      text-align: inherit;
    }

    #ida-{{ section.id }} .ida-photo-slider-title h2 {font-size: {{ section.settings.title_font_size }}px;font-weight: 500;line-height: 1;margin: 0 0 20px;color: {{section.settings.title_color}};}
    #ida-{{ section.id }} .ida-photo-slider-desc p {margin: 0;font-size: {{ section.settings.content_font_size }}px;line-height: 1.4;color: {{section.settings.content_color}};}
    #ida-{{ section.id }} .ida-photo-slider {display: flex;overflow: hidden;user-select: none;max-width: 1400px; margin-left: auto; margin-right: auto; gap: 5px;-webkit-mask-image: linear-gradient(to right, #000000, #ffffff 20%, #ffffff 80%, #000000);mask-image: linear-gradient(to right, #000000, #ffffff 20%, #ffffff 80%, #000000);}
    #ida-{{ section.id }} .ida-photo-slider__group {flex-shrink: 0;display: flex;align-items: center;justify-content: center;gap: 30px;margin-left: 30px;width: max-content;flex-wrap: nowrap;animation: ida-scroll-x {{ section.settings.speed }} linear infinite;}
    #ida-{{ section.id }} .ida-photo-image {width: auto;height: 100%;max-width: none;max-height: {{ section.settings.photo_size }}px;object-fit: {{ section.settings.image_fit }};border-radius: 8px;}
    #ida-{{ section.id }} .ida-photo-slider a { cursor: default; }
    #ida-{{ section.id }} .ida-photo-slider a[href] {cursor: pointer; }
    @keyframes ida-scroll-x {
      from { transform: translate3d(0, 0, 0); } 
      to { transform: translate3d(-100%, 0, 0); }
    }

    @media only screen and (max-width: 767px) {
      #ida-{{ section.id }}.ida-photo-slider-wrapper {padding: {{section.settings.top_padding_mobile}}px 0 {{section.settings.bottom_padding_mobile}}px 0;}
      #ida-{{ section.id }} .ida-photo-slider-title h2 {margin: 0 0 10px;font-size: {{ section.settings.mobile_title_font_size }}px;}
      #ida-{{ section.id }} .ida-photo-slider-desc p {font-size: {{ section.settings.mobile_content_font_size }}px;}
      #ida-{{ section.id }} .ida-photo-slider__group {gap: 20px;margin-left: 20px;}
      #ida-{{ section.id }} .ida-photo-image {max-height: {{ section.settings.mobile_photo_size }}px;}
    }
  </style>
{% endcapture %}
{{- ida_photo_slider_css | strip_newlines -}}

<div id="ida-{{ section.id }}" class="ida-photo-slider-wrapper">
  <div class="ida-page-width">
    {% if section.settings.title != blank or section.settings.content != blank %}

      <div class="ida-photo-slider-title">
        {% if section.settings.title != blank %}
          <h2>{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.content != blank %}
          <div class="ida-photo-slider-desc ida-section-desc">{{ section.settings.content }}</div>
        {% endif %}
      </div>
    {% endif %}
  </div>
  
  <div class="ida-photo-slider">
    <div class="ida-photo-slider__group">
      {% for block in section.blocks %}
        <a {% if block.settings.photo_url != blank %}href="{{ block.settings.photo_url }}"{% endif %}>
          {% if block.settings.photo != blank %}
            <img src="{{ block.settings.photo | image_url }}" class="ida-photo-image" alt="{{ block.settings.photo.alt | default: 'Photo slider item' }}" loading="lazy" width="" height="" style="height: {{ section.settings.photo_size }}px;">
          {% else %}
            <img src="data:image/svg+xml,%3C%3Fxml version='1.0' encoding='UTF-8'%3F%3E%3Csvg version='1.1' viewBox='0 0 200 150' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Crect x='2' y='2' width='200' height='150' fill='%23E5E5E5' stroke='%23CCCCCC' stroke-width='2'/%3E%3Ctext x='100' y='80' font-family='Arial' font-size='12' text-anchor='middle' fill='%23999999'%3EAdd Photo Here%3C/text%3E%3C/g%3E%3C/svg%3E" width="" height="" loading="lazy" class="ida-photo-image" style="height: {{ section.settings.photo_size }}px;" alt="Empty photo placeholder">
          {% endif %}
        </a>
      {% endfor %}
    </div>
    <div class="ida-photo-slider__group" aria-hidden="true">
      {% for block in section.blocks %}
        <a {% if block.settings.photo_url != blank %}href="{{ block.settings.photo_url }}"{% endif %}>
          {% if block.settings.photo != blank %}
            <img src="{{ block.settings.photo | image_url }}" class="ida-photo-image" alt="{{ block.settings.photo.alt | default: 'Photo slider item' }}" loading="lazy" width="" height="" style="height: {{ section.settings.photo_size }}px;">
          {% else %}
            <img src="data:image/svg+xml,%3C%3Fxml version='1.0' encoding='UTF-8'%3F%3E%3Csvg version='1.1' viewBox='0 0 200 150' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Crect x='2' y='2' width='200' height='150' fill='%23E5E5E5' stroke='%23CCCCCC' stroke-width='2'/%3E%3Ctext x='100' y='80' font-family='Arial' font-size='12' text-anchor='middle' fill='%23999999'%3EAdd Photo Here%3C/text%3E%3C/g%3E%3C/svg%3E" width="" height="" loading="lazy" class="ida-photo-image" style="height: {{ section.settings.photo_size }}px;" alt="Empty photo placeholder">
          {% endif %}
        </a>
      {% endfor %}
    </div>
  </div>
</div>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const slider = document.querySelector("#ida-{{ section.id }}").querySelector(".ida-photo-slider");
    const sliderGroup = document.querySelector("#ida-{{ section.id }}").querySelector(".ida-photo-slider__group");

    if (slider && sliderGroup) {
      const clone = sliderGroup.cloneNode(true);
      clone.setAttribute("aria-hidden", "true");
      slider.appendChild(clone);

      slider.style.display = "flex";
      slider.style.width = "max-content";

      // Pause animation on hover
      const sliderWrapper = document.querySelector("#ida-{{ section.id }}.ida-photo-slider-wrapper");
      sliderWrapper.addEventListener("mouseenter", () => {
        document.querySelectorAll("#ida-{{ section.id }} .ida-photo-slider__group").forEach(group => {
          group.style.animationPlayState = "paused";
        });
      });
      sliderWrapper.addEventListener("mouseleave", () => {
        document.querySelectorAll("#ida-{{ section.id }} .ida-photo-slider__group").forEach(group => {
          group.style.animationPlayState = "running";
        });
      });

      let scrollAmount = 0;
      // Use section speed setting for JS scroll fallback (convert CSS time to JS speed)
      const cssSpeed = section.settings.speed.replace('s', '');
      const scrollSpeed = (sliderGroup.offsetWidth / cssSpeed) / 60; // Adjust based on frame rate

      function autoScroll() {
        if (scrollAmount >= sliderGroup.offsetWidth) {
          scrollAmount = 0;
          slider.scrollLeft = 0;
        } else {
          scrollAmount += scrollSpeed;
          slider.scrollLeft = scrollAmount;
        }
        requestAnimationFrame(autoScroll);
      }
      autoScroll();
    }
  });
</script>

{% schema %}
{
  "name": "IDA: Photo Slider",
  "tag": "section",
  "class": "ida-section-photo-slider",
  "settings": [
    {
      "type": "paragraph",
      "content": "We recommend adding at least 5 photos for a proper preview"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured Photos"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Explore our curated collection of stunning photos from latest projects</p>"
    },
    {
      "type": "text_alignment",
      "id": "text_align",
      "label": "Text Alignment",
      "default": "center"
    },
    {
      "type": "range",
      "id": "photo_size",
      "min": 80,
      "max": 250,
      "step": 2,
      "unit": "px",
      "label": "Photo Height (Desktop)",
      "default": 150
    },
    {
      "type": "range",
      "id": "mobile_photo_size",
      "min": 60,
      "max": 180,
      "step": 2,
      "unit": "px",
      "label": "Photo Height (Mobile)",
      "default": 100
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image Fit",
      "options": [
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "fill",
          "label": "Fill"
        }
      ],
      "default": "contain"
    },
    {
      "type": "select",
      "id": "speed",
      "label": "Speed",
      "options": [
        {
          "value": "8s",
          "label": "Fast"
        },
        {
          "value": "14s",
          "label": "Medium"
        },
        {
          "value": "20s",
